@model TourismGuide.Entity.Place
@{
    ViewData["Title"] = "Yeni Mekan Ekle";
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2><i class="fa-solid fa-plus me-2"></i>Yeni Mekan Ekle</h2>
    <a asp-area="Admin" asp-controller="Places" asp-action="Index" class="btn btn-secondary">
        <i class="fa-solid fa-arrow-left me-1"></i> Listeye Dön
    </a>
</div>

<div class="card shadow-sm border-0 p-4">
    <form asp-area="Admin" asp-controller="Places" asp-action="Create" method="post" enctype="multipart/form-data">
        <div class="row g-3">
            <div class="col-md-6">
                <label class="form-label fw-bold">Mekan Adı</label>
                <input asp-for="Name" class="form-control" placeholder="Örn: Pamukkale Traverterleri" required />
                <span asp-validation-for="Name" class="text-danger"></span>
            </div>

            <div class="col-md-3">
                <label class="form-label fw-bold">Şehir</label>
                <select asp-for="CityId" asp-items="ViewBag.Cities" class="form-select" required>
                    <option value="">Şehir Seçin</option>
                </select>
                <span asp-validation-for="CityId" class="text-danger"></span>
            </div>

            <div class="col-md-3">
                <label class="form-label fw-bold">Kategori</label>
                <select asp-for="CategoryId" asp-items="ViewBag.Categories" class="form-select" required>
                    <option value="">Kategori Seçin</option>
                </select>
                <span asp-validation-for="CategoryId" class="text-danger"></span>
            </div>

            <div class="col-md-6">
                <label class="form-label fw-bold">Kısa Açıklama</label>
                <input asp-for="ShortDescription" class="form-control" placeholder="Örn: Denizli'de bulunan dünyaca ünlü travertenler" />
            </div>

            <div class="col-md-6">
                <label class="form-label fw-bold">Görsel Seçin (Dosya Yükle)</label>
                <input type="file" name="imageFile" class="form-control" accept="image/*" />
            </div>

            <div class="col-md-4">
                <label class="form-label fw-bold">Puan (0 - 5)</label>
                <input asp-for="Rating" type="number" step="0.1" min="0" max="5" class="form-control" value="4.5" />
            </div>

            <div class="col-md-4">
                <label class="form-label fw-bold">Fiyat (₺)</label>
                <input asp-for="Price" type="number" step="0.01" class="form-control" value="0" />
            </div>

            <div class="col-md-4 d-flex align-items-end mb-2">
                <div class="form-check form-switch ms-2">
                    <input asp-for="IsFree" class="form-check-input" type="checkbox" id="isFreeCheck">
                    <label class="form-check-label fw-bold ms-1" for="isFreeCheck">Giriş Ücretsiz mi?</label>
                </div>
            </div>

            <div class="col-12">
                <label class="form-label fw-bold">Detaylı Açıklama</label>
                <textarea asp-for="FullDescription" class="form-control" rows="4" placeholder="Mekan hakkında detaylı bilgi giriniz..."></textarea>
            </div>

            <div class="col-12 text-end mt-4">
                <button type="submit" class="btn btn-success px-4">
                    <i class="fa-solid fa-save me-1"></i> Kaydet
                </button>
            </div>
        </div>
    </form>
</div>