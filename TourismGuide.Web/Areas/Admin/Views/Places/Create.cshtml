@model TourismGuide.Entity.Place
@{
    ViewData["Title"] = "Yeni Mekan Ekle";
    var cities = ViewBag.Cities as List<TourismGuide.Entity.City>;
    var categories = ViewBag.Categories as List<TourismGuide.Entity.Category>;
}

<div class="row justify-content-center">
    <div class="col-lg-9">
        <div class="d-flex justify-content-between align-items-center mb-4">
            <div>
                <h2 class="fw-bold text-dark mb-1">
                    <i class="fa fa-location-dot text-primary me-2"></i>Yeni Mekan Ekle
                </h2>
                <p class="text-muted mb-0">Mekan detaylarını doldurarak yeni bir turistik mekan oluşturun.</p>
            </div>
            <a asp-area="Admin" asp-controller="Places" asp-action="Index" class="btn btn-outline-secondary rounded-pill px-3">
                <i class="fa fa-arrow-left me-1"></i> Listeye Dön
            </a>
        </div>

        <div class="admin-card">
            <form asp-area="Admin" asp-controller="Places" asp-action="Create" method="post" enctype="multipart/form-data">
                @Html.AntiForgeryToken()
                <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                <div class="row g-3">
                    <div class="col-md-6">
                        <label asp-for="Title" class="form-label fw-bold">Mekan Adı</label>
                        <input asp-for="Title" class="form-control" placeholder="Örn: Galata Kulesi" required />
                        <span asp-validation-for="Title" class="text-danger small"></span>
                    </div>

                    <div class="col-md-3">
                        <label asp-for="CityId" class="form-label fw-bold">Şehir</label>
                        <select asp-for="CityId" class="form-select" required>
                            <option value="">Şehir Seçiniz...</option>
                            @if (cities != null)
                            {
                                foreach (var city in cities)
                                {
                                    <option value="@city.Id">@city.Name</option>
                                }
                            }
                        </select>
                        <span asp-validation-for="CityId" class="text-danger small"></span>
                    </div>

                    <div class="col-md-3">
                        <label asp-for="CategoryId" class="form-label fw-bold">Kategori</label>
                        <select asp-for="CategoryId" class="form-select" required>
                            <option value="">Kategori Seçiniz...</option>
                            @if (categories != null)
                            {
                                foreach (var cat in categories)
                                {
                                    <option value="@cat.Id">@cat.Name</option>
                                }
                            }
                        </select>
                        <span asp-validation-for="CategoryId" class="text-danger small"></span>
                    </div>

                    <div class="col-md-6">
                        <label asp-for="Price" class="form-label fw-bold">Giriş Ücreti (₺)</label>
                        <input asp-for="Price" type="number" step="0.01" min="0" class="form-control" placeholder="Ücretsiz için 0" />
                        <span asp-validation-for="Price" class="text-danger small"></span>
                    </div>

                    <div class="col-md-6">
                        <label asp-for="Rating" class="form-label fw-bold">Puan</label>
                        <input asp-for="Rating" type="number" step="0.1" min="0" max="5" class="form-control" placeholder="Örn: 4.8" value="5.0" />
                        <span asp-validation-for="Rating" class="text-danger small"></span>
                    </div>

                    <div class="col-12">
                        <label class="form-label fw-bold">Görsel Yükle (Dosya)</label>
                        <input type="file" name="ImageFile" id="imageFileInput" class="form-control" accept="image/*" />
                        <small class="text-muted">Doğrudan bilgisayarınızdan resim yükleyebilirsiniz.</small>
                        <div id="imagePreviewContainer" class="mt-2 d-none">
                            <img id="imagePreview" src="#" alt="Önizleme" class="rounded border shadow-sm" style="max-height: 120px; object-fit: cover;" />
                        </div>
                    </div>

                    <div class="col-12">
                        <label asp-for="Address" class="form-label fw-bold">Adres</label>
                        <input asp-for="Address" class="form-control" placeholder="Örn: Bereketzade, 34421 Beyoğlu/İstanbul" />
                        <span asp-validation-for="Address" class="text-danger small"></span>
                    </div>

                    <div class="col-12">
                        <label asp-for="ShortDescription" class="form-label fw-bold">Kısa Açıklama</label>
                        <input asp-for="ShortDescription" class="form-control" placeholder="Mekan hakkında kısa bir özet" />
                        <span asp-validation-for="ShortDescription" class="text-danger small"></span>
                    </div>

                    <div class="col-12">
                        <label asp-for="FullDescription" class="form-label fw-bold">Detaylı Açıklama</label>
                        <textarea asp-for="FullDescription" class="form-control" rows="5" placeholder="Mekan hakkında detaylı bilgi, tarihçe, ziyaret saatleri vb..."></textarea>
                        <span asp-validation-for="FullDescription" class="text-danger small"></span>
                    </div>

                    <div class="col-12 text-end pt-3 border-top">
                        <a asp-area="Admin" asp-controller="Places" asp-action="Index" class="btn btn-light rounded-pill px-4 me-2">İptal</a>
                        <button type="submit" class="btn btn-primary rounded-pill px-4">
                            <i class="fa fa-save me-1"></i> Mekanı Kaydet
                        </button>
                    </div>
                </div>
            </form>
        </div>
    </div>
</div>

<script>
    document.getElementById('imageFileInput')?.addEventListener('change', function (e) {
        var file = e.target.files[0];
        if (file) {
            var reader = new FileReader();
            reader.onload = function (event) {
                var preview = document.getElementById('imagePreview');
                var container = document.getElementById('imagePreviewContainer');
                if (preview && container) {
                    preview.src = event.target.result;
                    container.classList.remove('d-none');
                }
            };
            reader.readAsDataURL(file);
        }
    });
</script>
