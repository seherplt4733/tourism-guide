@model List<TourismGuide.Entity.Place>
@{
    ViewData["Title"] = "Mekanlar";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h4 class="fw-bold text-dark mb-1">
            <i class="fa fa-location-dot text-primary me-2"></i>Mekan Yönetimi
        </h4>
        <p class="text-muted small mb-0">Sistemdeki tüm turistik mekanları görüntüleyin ve arayın.</p>
    </div>
    <a asp-area="Admin" asp-controller="Places" asp-action="Create" class="btn btn-primary rounded-pill px-4">
        <i class="fa fa-plus me-1"></i> Yeni Mekan Ekle
    </a>
</div>

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        <i class="fa fa-check-circle me-2"></i>@TempData["SuccessMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Kapat"></button>
    </div>
}

@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        <i class="fa fa-exclamation-triangle me-2"></i>@TempData["ErrorMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Kapat"></button>
    </div>
}

<div class="admin-card">
    <div class="table-responsive">
        <table id="placesTable" class="table table-hover align-middle w-100">
            <thead class="table-light">
                <tr>
                    <th style="min-width: 200px;">Mekan Adı</th>
                    <th>Şehir</th>
                    <th>Kategori</th>
                    <th>Puan</th>
                    <th>Fiyat</th>
                    <th class="text-center" style="min-width: 140px;">Vitrin / Öne Çıkan</th>
                    <th class="text-end" style="min-width: 220px;">İşlemler</th>
                </tr>
            </thead>
            <tbody>
                @if (Model != null)
                {
                    foreach (var item in Model)
                    {
                        <tr>
                            <td>
                                <div class="d-flex align-items-center">
                                    <img src="@(string.IsNullOrEmpty(item.ImageUrl) ? "/img/destination-1.jpg" : (item.ImageUrl.StartsWith("http") || item.ImageUrl.StartsWith("/") ? item.ImageUrl : "/img/" + System.IO.Path.GetFileName(item.ImageUrl)))" 
                                         alt="@item.Name" 
                                         class="rounded me-3 shadow-sm" 
                                         style="width: 50px; height: 50px; object-fit: cover;" 
                                         onerror="this.src='/img/destination-1.jpg';" />
                                    <div>
                                        <strong class="text-dark d-block">@item.Name</strong>
                                        <small class="text-muted text-truncate d-inline-block" style="max-width: 220px;">@item.ShortDescription</small>
                                    </div>
                                </div>
                            </td>
                            <td>
                                <span class="badge bg-light text-dark border">
                                    <i class="fa fa-city text-primary me-1"></i>@(item.City?.Name ?? "-")
                                </span>
                            </td>
                            <td>
                                <span class="badge bg-light text-primary border">@(item.Category?.Name ?? "-")</span>
                            </td>
                            <td>
                                <span class="text-warning small"><i class="fa-solid fa-star me-1"></i>@item.Rating</span>
                            </td>
                            <td>
                                @if (item.IsFree)
                                {
                                    <span class="badge bg-success">Ücretsiz</span>
                                }
                                else
                                {
                                    <span class="fw-bold text-dark">₺@item.Price.ToString("0.##")</span>
                                }
                            </td>
                            <td class="text-center">
                                <button type="button" 
                                        class="btn btn-sm rounded-pill px-3 fw-semibold toggle-featured-btn @(item.IsFeatured ? "btn-success text-white" : "btn-light text-secondary border")" 
                                        id="featured-btn-@item.Id"
                                        onclick="toggleFeatured(@item.Id)" 
                                        title="Öne Çıkarma Durumunu Değiştir">
                                    <i class="fa fa-star @(item.IsFeatured ? "text-warning" : "text-muted") me-1" id="featured-icon-@item.Id"></i>
                                    <span id="featured-text-@item.Id">@(item.IsFeatured ? "Öne Çıkarıldı" : "Standart")</span>
                                </button>
                            </td>
                            <td class="text-end">
                                <div class="d-inline-flex gap-1">
                                    <a href="/mekan-detay/@item.Id" target="_blank" class="btn btn-sm btn-outline-primary rounded-pill px-2" title="Siteye Git (Yeni Sekmede Aç)">
                                        <i class="fa fa-arrow-up-right-from-square me-1"></i> Görüntüle
                                    </a>
                                    <a asp-area="Admin" asp-controller="Places" asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-outline-warning rounded-pill px-2" title="Düzenle">
                                        <i class="fa fa-pen-to-square me-1"></i> Düzenle
                                    </a>
                                    <button type="button" class="btn btn-sm btn-outline-danger rounded-pill px-2" onclick="confirmDeletePlace(@item.Id, '@Html.Raw(item.Name.Replace("'", "\\'"))')" title="Sil">
                                        <i class="fa fa-trash me-1"></i> Sil
                                    </button>
                                </div>
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
</div>

<!-- Silme İşlemi Formu -->
<form id="deletePlaceForm" asp-area="Admin" asp-controller="Places" asp-action="Delete" method="post" style="display: none;">
    @Html.AntiForgeryToken()
    <input type="hidden" name="id" id="deletePlaceId" value="" />
</form>

@section Scripts {
    <script>
        $(document).ready(function () {
            $('#placesTable').DataTable({
                responsive: true,
                pageLength: 10
            });
        });

        function confirmDeletePlace(id, name) {
            Swal.fire({
                title: 'Mekanı Silmek İstiyor musunuz?',
                text: '"' + name + '" adlı mekan kalıcı olarak silinecektir. Bu işlem geri alınamaz!',
                icon: 'warning',
                showCancelButton: true,
                confirmButtonColor: '#d33',
                cancelButtonColor: '#6c757d',
                confirmButtonText: '<i class="fa fa-trash me-1"></i> Evet, Sil',
                cancelButtonText: 'İptal'
            }).then((result) => {
                if (result.isConfirmed) {
                    $('#deletePlaceId').val(id);
                    $('#deletePlaceForm').submit();
                }
            });
        }

        function toggleFeatured(id) {
            const btn = document.getElementById('featured-btn-' + id);
            const icon = document.getElementById('featured-icon-' + id);
            const text = document.getElementById('featured-text-' + id);

            if (!btn) return;
            btn.disabled = true;

            fetch('/yonetim/mekanlar/toggle-featured/' + id, {
                method: 'POST',
                headers: {
                    'X-Requested-With': 'XMLHttpRequest'
                }
            })
            .then(response => response.json())
            .then(data => {
                btn.disabled = false;
                if (data.success) {
                    if (data.isFeatured) {
                        btn.className = 'btn btn-sm rounded-pill px-3 fw-semibold toggle-featured-btn btn-success text-white';
                        if (icon) icon.className = 'fa fa-star text-warning me-1';
                        if (text) text.innerText = 'Öne Çıkarıldı';
                    } else {
                        btn.className = 'btn btn-sm rounded-pill px-3 fw-semibold toggle-featured-btn btn-light text-secondary border';
                        if (icon) icon.className = 'fa fa-star text-muted me-1';
                        if (text) text.innerText = 'Standart';
                    }

                    if (typeof Swal !== 'undefined') {
                        const Toast = Swal.mixin({
                            toast: true,
                            position: 'top-end',
                            showConfirmButton: false,
                            timer: 2000,
                            timerProgressBar: true
                        });
                        Toast.fire({
                            icon: 'success',
                            title: data.message
                        });
                    }
                } else {
                    alert(data.message || 'İşlem başarısız.');
                }
            })
            .catch(error => {
                btn.disabled = false;
                console.error('Error:', error);
                alert('İşlem sırasında bir hata meydana geldi.');
            });
        }
    </script>
}
