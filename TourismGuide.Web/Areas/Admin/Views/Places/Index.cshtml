@model List<TourismGuide.Entity.Place>
@{
    ViewData["Title"] = "Mekan Yönetimi";
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
}

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success alert-dismissible fade show mb-4" role="alert">
        <i class="fas fa-check-circle me-1"></i> @TempData["SuccessMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2><i class="fa-solid fa-map-location-dot me-2"></i>Mekan Yönetimi</h2>
    <a asp-area="Admin" asp-controller="Places" asp-action="Create" class="btn btn-primary">
        <i class="fa-solid fa-plus me-1"></i> Yeni Mekan Ekle
    </a>
</div>

<div class="card shadow-sm border-0">
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-dark">
                    <tr>
                        <th>Görsel</th>
                        <th>Mekan Adı</th>
                        <th>Şehir</th>
                        <th>Kategori</th>
                        <th>Puan</th>
                        <th>Fiyat</th>
                        <th class="text-end">İşlemler</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model != null && Model.Count > 0)
                    {
                        foreach (var item in Model)
                        {
                            var placeTitle = !string.IsNullOrEmpty(item.Name) ? item.Name : (!string.IsNullOrEmpty(item.Title) ? item.Title : "İsimsiz Mekan");
                            <tr>
                                <td>
                                    <img src="@item.ImageUrl" alt="@placeTitle" class="rounded shadow-sm" style="width: 50px; height: 50px; object-fit: cover;" onerror="this.src='/img/destination-1.jpg';" />
                                </td>
                                <td class="fw-bold">@placeTitle</td>
                                <td>@(item.City?.Name ?? "-")</td>
                                <td>
                                    <span class="badge bg-secondary">@(item.Category?.Name ?? "Genel")</span>
                                </td>
                                <td><i class="fa-solid fa-star text-warning me-1"></i>@item.Rating</td>
                                <td>@(item.IsFree ? "Ücretsiz" : $"₺{item.Price}")</td>
                                <td class="text-end">
                                    <a asp-area="Admin" asp-controller="Places" asp-action="Delete" asp-route-id="@item.Id" 
                                       class="btn btn-sm btn-outline-danger" 
                                       onclick="return confirm('Bu mekanı silmek istediğinize emin misiniz?');">
                                        <i class="fa-solid fa-trash"></i> Sil
                                    </a>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="7" class="text-center py-4 text-muted">Henüz eklenmiş bir mekan bulunmuyor.</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>