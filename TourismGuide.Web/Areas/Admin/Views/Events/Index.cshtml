@model List<TourismGuide.Entity.Event>
@{
    ViewData["Title"] = "Etkinlikler";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h4 class="fw-bold text-dark mb-1">
            <i class="fa fa-calendar-alt text-primary me-2"></i>Etkinlik Yönetimi
        </h4>
        <p class="text-muted small mb-0">Tüm etkinlikleri görüntüleyin, arayın ve yönetin.</p>
    </div>
    <a asp-area="Admin" asp-controller="Events" asp-action="Create" class="btn btn-primary rounded-pill px-4">
        <i class="fa fa-plus me-1"></i> Yeni Etkinlik Ekle
    </a>
</div>

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        <i class="fa fa-check-circle me-2"></i>@TempData["SuccessMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Kapat"></button>
    </div>
}

@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        <i class="fa fa-exclamation-triangle me-2"></i>@TempData["ErrorMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Kapat"></button>
    </div>
}

<div class="admin-card">
    <div class="table-responsive">
        <table id="eventsTable" class="table table-hover align-middle w-100">
            <thead class="table-light">
                <tr>
                    <th style="min-width: 220px;">Etkinlik Adı</th>
                    <th>Şehir</th>
                    <th>Tarih</th>
                    <th>Konum</th>
                    <th>Fiyat</th>
                    <th class="text-end" style="min-width: 220px;">İşlemler</th>
                </tr>
            </thead>
            <tbody>
                @if (Model != null)
                {
                    foreach (var item in Model)
                    {
                        var imgSrc = string.IsNullOrEmpty(item.ImageUrl) 
                            ? "/img/destination-1.jpg" 
                            : (item.ImageUrl.StartsWith("http") || item.ImageUrl.StartsWith("/") 
                                ? item.ImageUrl 
                                : (item.ImageUrl.StartsWith("uploads/") ? "/" + item.ImageUrl : "/img/" + System.IO.Path.GetFileName(item.ImageUrl)));

                        <tr>
                            <td>
                                <div class="d-flex align-items-center">
                                    <img src="@imgSrc" 
                                         alt="@item.Title" 
                                         class="rounded me-3 shadow-sm" 
                                         style="width: 50px; height: 50px; min-width: 50px; object-fit: cover;" 
                                         onerror="this.onerror=null; this.src='/img/destination-1.jpg';" />
                                    <div>
                                        <strong class="text-dark d-block">@item.Title</strong>
                                        <small class="text-muted text-truncate d-inline-block" style="max-width: 220px;">@item.Description</small>
                                    </div>
                                </div>
                            </td>
                            <td>
                                <span class="badge bg-light text-dark border">
                                    <i class="fa fa-map-marker-alt text-primary me-1"></i>@(item.City?.Name ?? "-")
                                </span>
                            </td>
                            <td>
                                <div class="fw-semibold text-dark">
                                    @item.EventDate.ToString("dd.MM.yyyy")
                                </div>
                                <small class="text-muted">
                                    <i class="fa fa-clock me-1 text-primary"></i>@item.EventDate.ToString("HH:mm")
                                </small>
                            </td>
                            <td>
                                <small class="text-secondary fw-semibold">
                                    <i class="fa fa-location-dot text-muted me-1"></i>@item.Location
                                </small>
                            </td>
                            <td>
                                @if (!item.Price.HasValue || item.Price.Value == 0)
                                {
                                    <span class="badge bg-success">Ücretsiz</span>
                                }
                                else
                                {
                                    <span class="fw-bold text-dark">₺@item.Price.Value.ToString("N0")</span>
                                }
                            </td>
                            <td class="text-end">
                                <div class="d-inline-flex gap-1">
                                    <a href="/etkinlik-detay/@item.Id" target="_blank" class="btn btn-sm btn-outline-primary rounded-pill px-2" title="Siteye Git (Yeni Sekmede Aç)">
                                        <i class="fa fa-arrow-up-right-from-square me-1"></i> Görüntüle
                                    </a>
                                    <a asp-area="Admin" asp-controller="Events" asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-outline-warning rounded-pill px-2" title="Düzenle">
                                        <i class="fa fa-pen-to-square me-1"></i> Düzenle
                                    </a>
                                    <button type="button" class="btn btn-sm btn-outline-danger rounded-pill px-2" onclick="confirmDeleteEvent(@item.Id, '@Html.Raw(item.Title.Replace("'", "\\'"))')" title="Sil">
                                        <i class="fa fa-trash me-1"></i> Sil
                                    </button>
                                </div>
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
</div>

<!-- Silme İşlemi Formu -->
<form id="deleteEventForm" asp-area="Admin" asp-controller="Events" asp-action="Delete" method="post" style="display: none;">
    @Html.AntiForgeryToken()
    <input type="hidden" name="id" id="deleteEventId" value="" />
</form>

@section Scripts {
    <script>
        $(document).ready(function () {
            $('#eventsTable').DataTable({
                responsive: true,
                order: [[2, 'desc']],
                pageLength: 10,
                language: {
                    search: "Ara:",
                    lengthMenu: "Sayfada _MENU_ kayıt göster",
                    info: "_TOTAL_ kayıttan _START_ - _END_ arası gösteriliyor",
                    infoEmpty: "Kayıt yok",
                    infoFiltered: "(_MAX_ kayıt içerisinden filtrelendi)",
                    zeroRecords: "Eşleşen kayıt bulunamadı",
                    paginate: {
                        first: "İlk",
                        last: "Son",
                        next: "Sonraki",
                        previous: "Önceki"
                    }
                }
            });
        });

        function confirmDeleteEvent(id, title) {
            if (typeof Swal !== 'undefined') {
                Swal.fire({
                    title: 'Etkinliği Silmek İstiyor musunuz?',
                    text: '"' + title + '" adlı etkinlik kalıcı olarak silinecektir. Bu işlem geri alınamaz!',
                    icon: 'warning',
                    showCancelButton: true,
                    confirmButtonColor: '#d33',
                    cancelButtonColor: '#6c757d',
                    confirmButtonText: '<i class="fa fa-trash me-1"></i> Evet, Sil',
                    cancelButtonText: 'İptal'
                }).then((result) => {
                    if (result.isConfirmed) {
                        $('#deleteEventId').val(id);
                        $('#deleteEventForm').submit();
                    }
                });
            } else {
                if (confirm('"' + title + '" adlı etkinliği silmek istediğinizden emin misiniz?')) {
                    $('#deleteEventId').val(id);
                    $('#deleteEventForm').submit();
                }
            }
        }
    </script>
}
