@model TourismGuide.Entity.Event
@{
    ViewData["Title"] = "Yeni Etkinlik Ekle";
    var cities = ViewBag.Cities as List<TourismGuide.Entity.City>;
}

<div class="row justify-content-center">
    <div class="col-lg-8">
        <div class="d-flex justify-content-between align-items-center mb-4">
            <div>
                <h2 class="fw-bold text-dark mb-1">
                    <i class="fa fa-calendar-plus text-primary me-2"></i>Yeni Etkinlik Ekle
                </h2>
                <p class="text-muted mb-0">Etkinlik detaylarını doldurarak yeni bir etkinlik oluşturun.</p>
            </div>
            <a asp-area="Admin" asp-controller="Events" asp-action="Index" class="btn btn-outline-secondary rounded-pill px-3">
                <i class="fa fa-arrow-left me-1"></i> Listeye Dön
            </a>
        </div>

        <div class="admin-card">
            <form asp-area="Admin" asp-controller="Events" asp-action="Create" method="post">
                @Html.AntiForgeryToken()
                <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                <div class="row g-3">
                    <div class="col-md-8">
                        <label asp-for="Title" class="form-label fw-bold">Etkinlik Başlığı</label>
                        <input asp-for="Title" class="form-control" placeholder="Örn: Uluslararası Caz Festivali" required />
                        <span asp-validation-for="Title" class="text-danger small"></span>
                    </div>

                    <div class="col-md-4">
                        <label asp-for="CityId" class="form-label fw-bold">Şehir</label>
                        <select asp-for="CityId" class="form-select" required>
                            <option value="">Şehir Seçiniz...</option>
                            @if (cities != null)
                            {
                                foreach (var city in cities)
                                {
                                    <option value="@city.Id">@city.Name</option>
                                }
                            }
                        </select>
                        <span asp-validation-for="CityId" class="text-danger small"></span>
                    </div>

                    <div class="col-md-6">
                        <label asp-for="EventDate" class="form-label fw-bold">Etkinlik Tarihi ve Saati</label>
                        <input asp-for="EventDate" type="datetime-local" class="form-control" required />
                        <span asp-validation-for="EventDate" class="text-danger small"></span>
                    </div>

                    <div class="col-md-6">
                        <label asp-for="Price" class="form-label fw-bold">Bilet Fiyatı (₺)</label>
                        <input asp-for="Price" type="number" step="0.01" min="0" class="form-control" placeholder="Ücretsiz için 0 veya boş bırakın" />
                        <span asp-validation-for="Price" class="text-danger small"></span>
                    </div>

                    <div class="col-12">
                        <label asp-for="Location" class="form-label fw-bold">Konum / Mekan</label>
                        <input asp-for="Location" class="form-control" placeholder="Örn: Harbiye Cemil Topuzlu Açıkhava Tiyatrosu" required />
                        <span asp-validation-for="Location" class="text-danger small"></span>
                    </div>

                    <div class="col-12">
                        <label asp-for="ImageUrl" class="form-label fw-bold">Görsel URL</label>
                        <input asp-for="ImageUrl" class="form-control" placeholder="https://... veya /img/event.jpg" required />
                        <span asp-validation-for="ImageUrl" class="text-danger small"></span>
                    </div>

                    <div class="col-12">
                        <label asp-for="Description" class="form-label fw-bold">Etkinlik Açıklaması</label>
                        <textarea asp-for="Description" class="form-control" rows="4" placeholder="Etkinlik hakkında detaylı bilgi verin..." required></textarea>
                        <span asp-validation-for="Description" class="text-danger small"></span>
                    </div>

                    <div class="col-12 text-end pt-3 border-top">
                        <a asp-area="Admin" asp-controller="Events" asp-action="Index" class="btn btn-light rounded-pill px-4 me-2">İptal</a>
                        <button type="submit" class="btn btn-primary rounded-pill px-4">
                            <i class="fa fa-save me-1"></i> Etkinliği Kaydet
                        </button>
                    </div>
                </div>
            </form>
        </div>
    </div>
</div>
