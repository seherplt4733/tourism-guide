@model TourismGuide.Entity.City
@{
    ViewData["Title"] = "Yeni Şehir Ekle";
}

<div class="row justify-content-center">
    <div class="col-lg-8">
        <div class="d-flex justify-content-between align-items-center mb-4">
            <div>
                <h2 class="fw-bold text-dark mb-1">
                    <i class="fa fa-city text-primary me-2"></i>Yeni Şehir Ekle
                </h2>
                <p class="text-muted mb-0">Sisteme yeni bir turistik şehir ve destinasyon kaydedin.</p>
            </div>
            <a asp-area="Admin" asp-controller="Cities" asp-action="Index" class="btn btn-outline-secondary rounded-pill px-3">
                <i class="fa fa-arrow-left me-1"></i> Listeye Dön
            </a>
        </div>

        <div class="admin-card">
            <form asp-area="Admin" asp-controller="Cities" asp-action="Create" method="post" enctype="multipart/form-data">
                @Html.AntiForgeryToken()
                <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                <div class="row g-3">
                    <div class="col-12">
                        <label asp-for="Name" class="form-label fw-bold">Şehir Adı</label>
                        <input asp-for="Name" class="form-control" placeholder="Örn: İstanbul, Antalya, Nevşehir" required />
                        <span asp-validation-for="Name" class="text-danger small"></span>
                    </div>

                    <div class="col-md-6">
                        <label class="form-label fw-bold">Şehir Görseli Yükle (Dosya)</label>
                        <input type="file" name="imageFile" class="form-control" accept="image/*" />
                        <small class="text-muted">Doğrudan bilgisayarınızdan resim yükleyebilirsiniz.</small>
                    </div>

                    <div class="col-md-6">
                        <label asp-for="ImageUrl" class="form-label fw-bold">Veya Görsel URL / Dosya Adı</label>
                        <input asp-for="ImageUrl" class="form-control" placeholder="istanbul.jpg veya /img/destination-1.jpg" />
                        <span asp-validation-for="ImageUrl" class="text-danger small"></span>
                    </div>

                    <div class="col-12">
                        <label asp-for="Description" class="form-label fw-bold">Şehir Açıklaması</label>
                        <textarea asp-for="Description" class="form-control" rows="4" placeholder="Şehir hakkında kısa ve etkileyici bir tanıtım yazısı..." required></textarea>
                        <span asp-validation-for="Description" class="text-danger small"></span>
                    </div>

                    <div class="col-12 text-end pt-3 border-top">
                        <a asp-area="Admin" asp-controller="Cities" asp-action="Index" class="btn btn-light rounded-pill px-4 me-2">İptal</a>
                        <button type="submit" class="btn btn-primary rounded-pill px-4">
                            <i class="fa fa-save me-1"></i> Şehri Kaydet
                        </button>
                    </div>
                </div>
            </form>
        </div>
    </div>
</div>
