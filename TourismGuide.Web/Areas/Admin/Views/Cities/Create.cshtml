@model TourismGuide.Entity.City
@{
    ViewData["Title"] = "Yeni Şehir Ekle";
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2><i class="fa-solid fa-plus me-2"></i>Yeni Şehir Ekle</h2>
    <a asp-area="Admin" asp-controller="Cities" asp-action="Index" class="btn btn-secondary">
        <i class="fa-solid fa-arrow-left me-1"></i> Listeye Dön
    </a>
</div>

<div class="card shadow-sm border-0 p-4" style="max-width: 600px;">
    <form asp-area="Admin" asp-controller="Cities" asp-action="Create" method="post">
        <div class="mb-3">
            <label class="form-label fw-bold">Şehir Adı</label>
            <input asp-for="Name" class="form-control" placeholder="Örn: Denizli, İstanbul, İzmir" required />
            <span asp-validation-for="Name" class="text-danger"></span>
        </div>
        <div class="text-end mt-4">
            <button type="submit" class="btn btn-success px-4">
                <i class="fa-solid fa-save me-1"></i> Kaydet
            </button>
        </div>
    </form>
</div>