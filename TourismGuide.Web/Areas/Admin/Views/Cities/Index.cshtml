@model List<TourismGuide.Entity.City>
@{
    ViewData["Title"] = "Şehir Yönetimi";
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
}

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        <i class="fas fa-check-circle me-1"></i> @TempData["SuccessMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2><i class="fa-solid fa-city me-2"></i>Şehir Yönetimi</h2>
    <a asp-area="Admin" asp-controller="Cities" asp-action="Create" class="btn btn-primary">
        <i class="fa-solid fa-plus me-1"></i> Yeni Şehir Ekle
    </a>
</div>

<div class="card shadow-sm border-0">
    <div class="card-body p-0">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-dark">
                <tr>
                    <th>#</th>
                    <th>Şehir Adı</th>
                    <th class="text-end">İşlemler</th>
                </tr>
            </thead>
            <tbody>
                @if (Model != null && Model.Count > 0)
                {
                    int index = 1;
                    foreach (var city in Model)
                    {
                        <tr>
                            <td>@(index++)</td>
                            <td class="fw-bold">@city.Name</td>
                            <td class="text-end">
                                <a asp-area="Admin" asp-controller="Cities" asp-action="Delete" asp-route-id="@city.Id" 
                                   class="btn btn-sm btn-outline-danger" 
                                   onclick="return confirm('Bu şehri silmek istediğinize emin misiniz?');">
                                    <i class="fa-solid fa-trash"></i> Sil
                                </a>
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="3" class="text-center py-4 text-muted">Henüz şehir eklenmemiş.</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>