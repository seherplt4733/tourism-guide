@model List<TourismGuide.Entity.City>
@{
    ViewData["Title"] = "Şehirler";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h4 class="fw-bold text-dark mb-1">
            <i class="fa fa-city text-primary me-2"></i>Şehir Yönetimi
        </h4>
        <p class="text-muted small mb-0">Sistemde tanımlı tüm şehirleri ve bağlı mekan sayılarını listeleyin.</p>
    </div>
</div>

<div class="admin-card">
    <div class="table-responsive">
        <table id="citiesTable" class="table table-hover align-middle w-100">
            <thead class="table-light">
                <tr>
                    <th style="min-width: 180px;">Şehir Adı</th>
                    <th>Açıklama</th>
                    <th>Bağlı Mekan Sayısı</th>
                </tr>
            </thead>
            <tbody>
                @if (Model != null)
                {
                    foreach (var city in Model)
                    {
                        <tr>
                            <td>
                                <div class="d-flex align-items-center">
                                    @if (!string.IsNullOrEmpty(city.ImageUrl))
                                    {
                                        <img src="@city.ImageUrl" alt="@city.Name" class="rounded me-3 shadow-sm" style="width: 50px; height: 50px; object-fit: cover;" />
                                    }
                                    <strong class="text-dark">@city.Name</strong>
                                </div>
                            </td>
                            <td>
                                <small class="text-muted text-truncate d-inline-block" style="max-width: 400px;">@city.Description</small>
                            </td>
                            <td>
                                <span class="badge bg-primary rounded-pill px-3 py-2">@(city.Places?.Count ?? 0) Mekan</span>
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
</div>

@section Scripts {
    <script>
        $(document).ready(function () {
            $('#citiesTable').DataTable({
                responsive: true,
                pageLength: 10
            });
        });
    </script>
}
