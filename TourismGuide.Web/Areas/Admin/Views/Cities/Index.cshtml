@model List<TourismGuide.Entity.City>
@using TourismGuide.Business.Utilities
@{
    ViewData["Title"] = "Şehirler";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h4 class="fw-bold text-dark mb-1">
            <i class="fa fa-city text-primary me-2"></i>Şehir Yönetimi
        </h4>
        <p class="text-muted small mb-0">Sistemde tanımlı tüm şehirleri ve bağlı mekan sayılarını listeleyin.</p>
    </div>
    <a asp-area="Admin" asp-controller="Cities" asp-action="Create" class="btn btn-primary rounded-pill px-4">
        <i class="fa fa-plus me-1"></i> Yeni Şehir Ekle
    </a>
</div>

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        <i class="fa fa-check-circle me-2"></i>@TempData["SuccessMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Kapat"></button>
    </div>
}

@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        <i class="fa fa-exclamation-triangle me-2"></i>@TempData["ErrorMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Kapat"></button>
    </div>
}

<div class="admin-card">
    <div class="table-responsive">
        <table id="citiesTable" class="table table-hover align-middle w-100">
            <thead class="table-light">
                <tr>
                    <th style="min-width: 180px;">Şehir Adı</th>
                    <th>Açıklama</th>
                    <th>Bağlı Mekan Sayısı</th>
                    <th class="text-end" style="min-width: 220px;">İşlemler</th>
                </tr>
            </thead>
            <tbody>
                @if (Model != null)
                {
                    foreach (var city in Model)
                    {
                        var placesCount = city.Places?.Count ?? 0;
                        var cityName = city.Name ?? string.Empty;
                        var badgeText = TextHelper.GetCityAbbreviation(cityName);

                        // Gerçek yüklenmiş yerel görsel kontrolü (destination-1.jpg ve unsplash varsayılan/kırık URL'ler hariç)
                        var hasCustomImage = !string.IsNullOrWhiteSpace(city.ImageUrl) 
                            && !city.ImageUrl.Contains("destination-1.jpg") 
                            && !city.ImageUrl.Contains("unsplash.com");

                        var imageSrc = hasCustomImage && city.ImageUrl != null
                            ? (city.ImageUrl.StartsWith("http") || city.ImageUrl.StartsWith("/") ? city.ImageUrl : "/img/" + System.IO.Path.GetFileName(city.ImageUrl))
                            : string.Empty;

                        <tr>
                            <td>
                                <div class="d-flex align-items-center">
                                    @if (hasCustomImage)
                                    {
                                        <img src="@imageSrc" 
                                             alt="@city.Name" 
                                             class="rounded-circle shadow-sm me-3" 
                                             style="width: 48px; height: 48px; min-width: 48px; object-fit: cover; border: 2px solid #86b817;" 
                                             onerror="this.style.display='none'; document.getElementById('city-badge-@city.Id').style.display='inline-flex';" />
                                        <div id="city-badge-@city.Id" 
                                             class="rounded-circle shadow-sm me-3" 
                                             style="display: none; width: 48px; height: 48px; min-width: 48px; background-color: rgba(134, 184, 23, 0.15); color: #7bb017; border: 2px solid rgba(134, 184, 23, 0.4); font-weight: 800; font-size: 0.95rem; letter-spacing: 0.5px; align-items: center; justify-content: center; text-transform: uppercase;">
                                            @badgeText
                                        </div>
                                    }
                                    else
                                    {
                                        <div class="rounded-circle shadow-sm me-3" 
                                             style="width: 48px; height: 48px; min-width: 48px; background-color: rgba(134, 184, 23, 0.15); color: #7bb017; border: 2px solid rgba(134, 184, 23, 0.4); font-weight: 800; font-size: 0.95rem; letter-spacing: 0.5px; display: inline-flex; align-items: center; justify-content: center; text-transform: uppercase;">
                                            @badgeText
                                        </div>
                                    }
                                    <div>
                                        <strong class="text-dark">@city.Name</strong>
                                    </div>
                                </div>
                            </td>
                            <td>
                                @if (!string.IsNullOrWhiteSpace(city.Description))
                                {
                                    <small class="text-muted text-truncate d-inline-block" style="max-width: 350px;" title="@city.Description">@city.Description</small>
                                }
                                else
                                {
                                    <span class="text-muted">—</span>
                                }
                            </td>
                            <td>
                                <span class="badge bg-light text-primary border rounded-pill px-3 py-2">
                                    <i class="fa fa-location-dot me-1"></i>@placesCount Mekan
                                </span>
                            </td>
                            <td class="text-end">
                                <div class="d-inline-flex gap-1">
                                    <a href="/?searchKeyword=@city.Name#places" target="_blank" class="btn btn-sm btn-outline-primary rounded-pill px-2" title="Siteye Git (Yeni Sekmede Aç)">
                                        <i class="fa fa-arrow-up-right-from-square me-1"></i> Siteye Git
                                    </a>
                                    <a asp-area="Admin" asp-controller="Cities" asp-action="Edit" asp-route-id="@city.Id" class="btn btn-sm btn-outline-warning rounded-pill px-2" title="Düzenle">
                                        <i class="fa fa-pen-to-square me-1"></i> Düzenle
                                    </a>
                                    <button type="button" class="btn btn-sm btn-outline-danger rounded-pill px-2" onclick="confirmDeleteCity(@city.Id, '@Html.Raw(city.Name.Replace("'", "\\'"))', @placesCount)" title="Sil">
                                        <i class="fa fa-trash me-1"></i> Sil
                                    </button>
                                </div>
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
</div>

<!-- Silme İşlemi Formu -->
<form id="deleteCityForm" asp-area="Admin" asp-controller="Cities" asp-action="Delete" method="post" style="display: none;">
    @Html.AntiForgeryToken()
    <input type="hidden" name="id" id="deleteCityId" value="" />
</form>

@section Scripts {
    <script>
        $(document).ready(function () {
            $('#citiesTable').DataTable({
                responsive: true,
                pageLength: 10
            });
        });

        function confirmDeleteCity(id, name, placesCount) {
            if (placesCount > 0) {
                Swal.fire({
                    title: 'Şehir Silinemez!',
                    text: '"' + name + '" şehrine bağlı ' + placesCount + ' adet mekan bulunmaktadır. Bu şehri silebilmek için önce bağlı mekanları silmeli veya başka bir şehre taşımalısınız.',
                    icon: 'error',
                    confirmButtonColor: '#86B817',
                    confirmButtonText: 'Tamam'
                });
                return;
            }

            Swal.fire({
                title: 'Şehri Silmek İstiyor musunuz?',
                text: '"' + name + '" adlı şehir kalıcı olarak silinecektir. Bu işlem geri alınamaz!',
                icon: 'warning',
                showCancelButton: true,
                confirmButtonColor: '#d33',
                cancelButtonColor: '#6c757d',
                confirmButtonText: '<i class="fa fa-trash me-1"></i> Evet, Sil',
                cancelButtonText: 'İptal'
            }).then((result) => {
                if (result.isConfirmed) {
                    $('#deleteCityId').val(id);
                    $('#deleteCityForm').submit();
                }
            });
        }
    </script>
}
