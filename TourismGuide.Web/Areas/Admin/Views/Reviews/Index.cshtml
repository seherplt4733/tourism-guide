@model List<TourismGuide.Entity.Review>
@{
    ViewData["Title"] = "Yorumlar";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h4 class="fw-bold text-dark mb-1">
            <i class="fa fa-comments text-primary me-2"></i>Kullanıcı Yorumları
        </h4>
        <p class="text-muted small mb-0">Mekanlara yapılan tüm yorum ve değerlendirmeleri görüntüleyin.</p>
    </div>
</div>

<div class="admin-card">
    <div class="table-responsive">
        <table id="reviewsTable" class="table table-hover align-middle w-100">
            <thead class="table-light">
                <tr>
                    <th>Yorum Yapan</th>
                    <th>E-posta</th>
                    <th>Mekan</th>
                    <th>Puan</th>
                    <th>Yorum</th>
                    <th>Tarih</th>
                </tr>
            </thead>
            <tbody>
                @if (Model != null)
                {
                    foreach (var review in Model)
                    {
                        <tr>
                            <td>
                                <strong class="text-dark">@(string.IsNullOrEmpty(review.ReviewerName) ? "Misafir" : review.ReviewerName)</strong>
                            </td>
                            <td>
                                <small class="text-muted">@(string.IsNullOrEmpty(review.Email) ? "-" : review.Email)</small>
                            </td>
                            <td>
                                <span class="badge bg-light text-dark border">
                                    <i class="fa fa-location-dot text-primary me-1"></i>@(review.Place?.Name ?? "-")
                                </span>
                            </td>
                            <td>
                                <span class="text-warning small">
                                    @for (int i = 1; i <= 5; i++)
                                    {
                                        if (i <= review.Rating)
                                        {
                                            <i class="fa-solid fa-star"></i>
                                        }
                                        else
                                        {
                                            <i class="fa-regular fa-star text-muted"></i>
                                        }
                                    }
                                </span>
                            </td>
                            <td>
                                <small class="text-secondary text-truncate d-inline-block" style="max-width: 300px;">@review.Comment</small>
                            </td>
                            <td>
                                <small class="text-muted">@review.CreatedAt.ToString("dd.MM.yyyy HH:mm")</small>
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
</div>

@section Scripts {
    <script>
        $(document).ready(function () {
            $('#reviewsTable').DataTable({
                responsive: true,
                order: [[5, 'desc']],
                pageLength: 10
            });
        });
    </script>
}
