@model List<TourismGuide.Entity.ContactMessage>
@{
    ViewData["Title"] = "Gelen Mesajlar";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h4 class="fw-bold text-dark mb-1">
            <i class="fa fa-envelope text-primary me-2"></i>Gelen Mesajlar
        </h4>
        <p class="text-muted small mb-0">İletişim formundan gönderilen tüm mesajları görüntüleyin ve yönetin.</p>
    </div>
</div>

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        <i class="fa fa-check-circle me-2"></i>@TempData["SuccessMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Kapat"></button>
    </div>
}

<div class="admin-card">
    <div class="table-responsive">
        <table id="messagesTable" class="table table-hover align-middle w-100">
            <thead class="table-light">
                <tr>
                    <th>Gönderen</th>
                    <th>E-posta</th>
                    <th>Konu</th>
                    <th>Mesaj</th>
                    <th>Tarih</th>
                    <th>Durum</th>
                    <th class="text-end">İşlemler</th>
                </tr>
            </thead>
            <tbody>
                @if (Model != null)
                {
                    foreach (var msg in Model)
                    {
                        <tr class="@(!msg.IsRead ? "fw-bold table-light" : "")">
                            <td>
                                <strong class="text-dark">@msg.FullName</strong>
                            </td>
                            <td>
                                <a href="mailto:@msg.Email" class="text-decoration-none">
                                    <small class="text-muted"><i class="fa fa-envelope me-1"></i>@msg.Email</small>
                                </a>
                            </td>
                            <td>
                                <span class="badge bg-light text-dark border">@msg.Subject</span>
                            </td>
                            <td>
                                <span class="text-secondary text-truncate d-inline-block" style="max-width: 250px;" title="@msg.Message">
                                    @msg.Message
                                </span>
                            </td>
                            <td>
                                <small class="text-muted">@msg.CreatedAt.ToString("dd.MM.yyyy HH:mm")</small>
                            </td>
                            <td>
                                @if (msg.IsRead)
                                {
                                    <span class="badge bg-success">
                                        <i class="fa fa-envelope-open me-1"></i>Okundu
                                    </span>
                                }
                                else
                                {
                                    <span class="badge bg-danger">
                                        <i class="fa fa-envelope me-1"></i>Okunmadı
                                    </span>
                                }
                            </td>
                            <td class="text-end">
                                <div class="d-inline-flex gap-1">
                                    <!-- Mesaj Detay Modalı Tetikleyici -->
                                    <button type="button" class="btn btn-sm btn-outline-primary rounded-pill px-2" 
                                            data-bs-toggle="modal" 
                                            data-bs-target="#msgModal-@msg.Id" 
                                            title="Mesajı Oku">
                                        <i class="fa fa-eye me-1"></i>Oku
                                    </button>

                                    <!-- Cevapla Butonu -->
                                    <a href="mailto:@msg.Email?subject=@Uri.EscapeDataString("Re: " + msg.Subject)&body=@Uri.EscapeDataString("\n\n--- " + msg.FullName + " tarafından gönderilen mesaj ---\n" + msg.Message)" 
                                       class="btn btn-sm btn-outline-info rounded-pill px-2" 
                                       title="Cevapla (E-posta Gönder)" 
                                       onclick="markMessageRead(@msg.Id)">
                                        <i class="fa fa-reply me-1"></i>Cevapla
                                    </a>

                                    @if (!msg.IsRead)
                                    {
                                        <form asp-area="Admin" asp-controller="Messages" asp-action="MarkAsRead" asp-route-id="@msg.Id" method="post" class="d-inline">
                                            @Html.AntiForgeryToken()
                                            <button type="submit" class="btn btn-sm btn-outline-success rounded-pill px-2" title="Okundu İşaretle">
                                                <i class="fa fa-check"></i>
                                            </button>
                                        </form>
                                    }

                                    <button type="button" class="btn btn-sm btn-outline-danger rounded-pill px-2" onclick="confirmDeleteMessage(@msg.Id, '@Html.Raw(msg.FullName.Replace("'", "\\'"))')" title="Sil">
                                        <i class="fa fa-trash"></i>
                                    </button>
                                </div>

                                <!-- Modal -->
                                <div class="modal fade text-start" id="msgModal-@msg.Id" tabindex="-1" aria-hidden="true">
                                    <div class="modal-dialog modal-dialog-centered">
                                        <div class="modal-content">
                                            <div class="modal-header">
                                                <h5 class="modal-title fw-bold">
                                                    <i class="fa fa-envelope text-primary me-2"></i>@msg.Subject
                                                </h5>
                                                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Kapat"></button>
                                            </div>
                                            <div class="modal-body">
                                                <div class="mb-3">
                                                    <label class="form-label text-muted small mb-0">Gönderen</label>
                                                    <p class="fw-bold mb-0">@msg.FullName (<a href="mailto:@msg.Email">@msg.Email</a>)</p>
                                                </div>
                                                <div class="mb-3">
                                                    <label class="form-label text-muted small mb-0">Tarih</label>
                                                    <p class="text-secondary small mb-0">@msg.CreatedAt.ToString("dd MMMM yyyy HH:mm", new System.Globalization.CultureInfo("tr-TR"))</p>
                                                </div>
                                                <hr />
                                                <div class="mb-3">
                                                    <label class="form-label text-muted small mb-1">Mesaj İçeriği</label>
                                                    <div class="p-3 bg-light rounded border" style="white-space: pre-wrap;">@msg.Message</div>
                                                </div>
                                            </div>
                                            <div class="modal-footer">
                                                <a href="mailto:@msg.Email?subject=@Uri.EscapeDataString("Re: " + msg.Subject)&body=@Uri.EscapeDataString("\n\n--- " + msg.FullName + " tarafından gönderilen mesaj ---\n" + msg.Message)" 
                                                   class="btn btn-sm btn-info text-white rounded-pill px-3" 
                                                   onclick="markMessageRead(@msg.Id)">
                                                    <i class="fa fa-reply me-1"></i> E-posta ile Cevapla
                                                </a>
                                                @if (!msg.IsRead)
                                                {
                                                    <form asp-area="Admin" asp-controller="Messages" asp-action="MarkAsRead" asp-route-id="@msg.Id" method="post" class="d-inline">
                                                        @Html.AntiForgeryToken()
                                                        <button type="submit" class="btn btn-sm btn-success rounded-pill px-3">
                                                            <i class="fa fa-check me-1"></i>Okundu İşaretle
                                                        </button>
                                                    </form>
                                                }
                                                <button type="button" class="btn btn-sm btn-secondary rounded-pill px-3" data-bs-dismiss="modal">Kapat</button>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
</div>

<!-- Silme Formu -->
<form id="deleteMessageForm" asp-area="Admin" asp-controller="Messages" asp-action="Delete" method="post" style="display: none;">
    @Html.AntiForgeryToken()
    <input type="hidden" name="id" id="deleteMessageId" value="" />
</form>

@section Scripts {
    <script>
        $(document).ready(function () {
            $('#messagesTable').DataTable({
                responsive: true,
                order: [[4, 'desc']],
                pageLength: 10
            });
        });

        function markMessageRead(id) {
            $.post('/Admin/Messages/MarkAsReadAjax/' + id, function () {
                // Background update
            });
        }

        function confirmDeleteMessage(id, name) {
            Swal.fire({
                title: 'Mesajı Silmek İstiyor musunuz?',
                text: '"' + name + '" tarafından gönderilen bu mesaj kalıcı olarak silinecektir.',
                icon: 'warning',
                showCancelButton: true,
                confirmButtonColor: '#d33',
                cancelButtonColor: '#6c757d',
                confirmButtonText: '<i class="fa fa-trash me-1"></i> Evet, Sil',
                cancelButtonText: 'İptal'
            }).then((result) => {
                if (result.isConfirmed) {
                    $('#deleteMessageId').val(id);
                    $('#deleteMessageForm').submit();
                }
            });
        }
    </script>
}
