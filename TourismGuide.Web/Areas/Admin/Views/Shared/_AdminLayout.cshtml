<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Tourism Guide Admin Paneli</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />
    <style>
        body { font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif; background-color: #f8f9fa; }
        .sidebar { min-height: 100vh; background-color: #212529; color: #fff; }
        .sidebar a { color: #adb5bd; text-decoration: none; padding: 12px 20px; display: block; border-radius: 6px; margin-bottom: 4px; }
        .sidebar a:hover, .sidebar a.active { background-color: #0d6efd; color: #fff; }
        .content { padding: 30px; }
    </style>
</head>
<body>
    <div class="container-fluid">
        <div class="row">
            <!-- Sidebar / Yan Menü -->
            <div class="col-md-3 col-lg-2 sidebar p-3">
                <h4 class="text-white text-center mb-4 py-2 border-bottom">
                    <i class="fa-solid fa-compass me-2"></i>Admin Panel
                </h4>
                <nav>
                    <a asp-area="Admin" asp-controller="Dashboard" asp-action="Index" class="nav-link">
                        <i class="fa-solid fa-chart-line me-2"></i>Dashboard
                    </a>
                    <a asp-area="Admin" asp-controller="Places" asp-action="Index" class="nav-link">
                        <i class="fa-solid fa-map-location-dot me-2"></i>Mekan Yönetimi
                    </a>
                    <a asp-area="Admin" asp-controller="Cities" asp-action="Index" class="nav-link">
                     <i class="fa-solid fa-city me-2"></i>Şehir Yönetimi
                     </a>
                     <a asp-area="Admin" asp-controller="Categories" asp-action="Index" class="nav-link">
                       <i class="fa-solid fa-list me-2"></i>Kategori Yönetimi
                     </a>
                    <a asp-area="Admin" asp-controller="Reviews" asp-action="Index" class="nav-link">
                        <i class="fa-solid fa-star me-2"></i>Yorum Yönetimi
                    </a>
                    <hr class="text-secondary" />
                    <a asp-area="" asp-controller="Home" asp-action="Index" class="nav-link text-warning" target="_blank">
                        <i class="fa-solid fa-globe me-2"></i>Siteye Git
                    </a>
                    <a asp-area="Admin" asp-controller="Account" asp-action="Logout" class="nav-link text-danger mt-2">
                        <i class="fa-solid fa-right-from-bracket me-2"></i>Çıkış Yap
                    </a>
                </nav>
            </div>

            <!-- Main Content / Ana İçerik -->
            <div class="col-md-9 col-lg-10 content">
                @RenderBody()
            </div>
        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>