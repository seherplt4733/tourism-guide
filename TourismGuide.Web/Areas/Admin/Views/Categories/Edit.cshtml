@model TourismGuide.Entity.Category
@{
    ViewData["Title"] = "Kategori Düzenle";
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2><i class="fa-solid fa-pen-to-square me-2"></i>Kategori Düzenle</h2>
    <a asp-area="Admin" asp-controller="Categories" asp-action="Index" class="btn btn-secondary">
        <i class="fa-solid fa-arrow-left me-1"></i> Listeye Dön
    </a>
</div>

<div class="card shadow-sm border-0 p-4" style="max-width: 600px;">
    <form asp-area="Admin" asp-controller="Categories" asp-action="Edit" method="post">
        <input type="hidden" asp-for="Id" />
        <div class="mb-3">
            <label class="form-label fw-bold">Kategori Adı</label>
            <input asp-for="Name" class="form-control" required />
            <span asp-validation-for="Name" class="text-danger"></span>
        </div>
        <div class="mb-3">
            <label class="form-label fw-bold">Açıklama</label>
            <input asp-for="Description" class="form-control" />
        </div>
        <div class="mb-3">
            <label class="form-label fw-bold">İkon CSS Sınıfı (İsteğe Bağlı)</label>
            <input asp-for="IconCssClass" class="form-control" />
        </div>
        <div class="text-end mt-4">
            <button type="submit" class="btn btn-primary px-4">
                <i class="fa-solid fa-save me-1"></i> Güncelle
            </button>
        </div>
    </form>
</div>