@{
    ViewData["Title"] = "Yetkisiz Erişim";
}

<div class="container py-5 text-center my-5">
    <div class="row justify-content-center">
        <div class="col-lg-6">
            <div class="bg-white p-5 rounded-4 shadow-sm border">
                <div class="rounded-circle d-inline-flex align-items-center justify-content-center mb-4" style="width: 80px; height: 80px; background-color: rgba(220, 53, 69, 0.1); color: #dc3545;">
                    <i class="fa fa-shield-halved fs-1"></i>
                </div>
                <h2 class="fw-bold text-dark mb-3">Yetkisiz Erişim</h2>
                <p class="text-muted mb-4">
                    Bu sayfayı görüntülemek için gerekli yönetici izinlerine sahip değilsiniz. Tourist Yönetim Paneli'ne yalnızca sistem yöneticileri erişebilir.
                </p>
                <div class="d-flex justify-content-center gap-3">
                    <a href="/" class="btn btn-primary rounded-pill px-4 py-2">
                        <i class="fa fa-home me-2"></i>Anasayfaya Dön
                    </a>
                    <a asp-controller="Account" asp-action="Profile" class="btn btn-outline-secondary rounded-pill px-4 py-2">
                        <i class="fa fa-user me-2"></i>Profilim
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>
