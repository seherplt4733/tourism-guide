@model TourismGuide.Web.Models.LoginViewModel
@{
    ViewData["Title"] = "Giriş Yap";
    var returnUrl = ViewData["ReturnUrl"] as string;
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-lg-5 col-md-8">
            <div class="card border-0 shadow-lg rounded-4 overflow-hidden">
                <div class="card-header bg-primary text-white text-center py-4">
                    <h3 class="fw-bold mb-1 text-white">
                        <i class="fa fa-sign-in-alt me-2"></i>Giriş Yap
                    </h3>
                    <p class="mb-0 text-white-50">Hesabınıza giriş yaparak deneyiminize devam edin.</p>
                </div>

                <div class="card-body p-4 p-md-5 bg-white">
                    <form asp-controller="Account" asp-action="Login" asp-route-returnurl="@returnUrl" method="post">
                        @Html.AntiForgeryToken()

                        <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 small" role="alert"></div>

                        <!-- E-posta -->
                        <div class="form-floating mb-3">
                            <input asp-for="Email" type="email" class="form-control" id="emailLoginInput" placeholder="ornek@email.com" required />
                            <label for="emailLoginInput"><i class="fa fa-envelope me-2 text-muted"></i>E-posta Adresi</label>
                            <span asp-validation-for="Email" class="text-danger small"></span>
                        </div>

                        <!-- Şifre -->
                        <div class="form-floating mb-3">
                            <input asp-for="Password" type="password" class="form-control" id="passwordLoginInput" placeholder="Şifre" required />
                            <label for="passwordLoginInput"><i class="fa fa-lock me-2 text-muted"></i>Şifre</label>
                            <span asp-validation-for="Password" class="text-danger small"></span>
                        </div>

                        <!-- Beni Hatırla -->
                        <div class="form-check mb-4">
                            <input asp-for="RememberMe" class="form-check-input" type="checkbox" id="rememberMeCheck" />
                            <label class="form-check-label text-muted small" for="rememberMeCheck">
                                Beni Hatırla
                            </label>
                        </div>

                        <div class="d-grid mb-3">
                            <button type="submit" class="btn btn-primary rounded-pill py-3 fw-bold fs-6">
                                <i class="fa fa-sign-in-alt me-2"></i>Giriş Yap
                            </button>
                        </div>

                        <div class="text-center pt-3 border-top">
                            <span class="text-muted small">Henüz bir hesabınız yok mu?</span>
                            <a asp-controller="Account" asp-action="Register" class="fw-bold text-primary ms-1 small">Hemen Kayıt Ol</a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>
