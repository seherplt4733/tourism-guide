@model Microsoft.AspNetCore.Identity.IdentityUser
@{
    ViewData["Title"] = "Profilim";
    var favorites = ViewBag.Favorites as List<TourismGuide.Entity.Favorite>;
}

<div class="container py-5">
    <div class="row">
        <div class="col-lg-3">
            <div class="bg-white rounded shadow-sm border p-4 text-center">
                <i class="fa fa-user-circle text-primary" style="font-size: 5rem;"></i>
                <h4 class="mt-3 mb-1">Hoş Geldin!</h4>
                <p class="text-muted small">@Model.Email</p>
                <hr>
                <div class="d-grid gap-2">
                    <a href="/Account/Profile" class="btn btn-primary"><i class="fa fa-heart me-2"></i>Favorilerim</a>
                    <a href="#" class="btn btn-outline-secondary"><i class="fa fa-comment me-2"></i>Yorumlarım</a>
                    <form asp-controller="Account" asp-action="Logout" method="post">
                        @Html.AntiForgeryToken()
                        <button type="submit" class="btn btn-outline-danger w-100"><i class="fa fa-sign-out-alt me-2"></i>Çıkış Yap</button>
                    </form>
                </div>
            </div>
        </div>
        <div class="col-lg-9">
            <div class="bg-white rounded shadow-sm border p-4">
                <h4 class="mb-4 text-primary"><i class="fa fa-heart me-2"></i>Favori Mekanlarım (@(favorites?.Count ?? 0))</h4>
                @if (favorites != null && favorites.Count > 0)
                {
                    <div class="row g-4">
                        @foreach (var fav in favorites)
                        {
                            var place = fav.Place;
                            if (place != null)
                            {
                                <div class="col-md-6 col-lg-4">
                                    <div class="card h-100 shadow-sm border-0">
                                        <img src="/img/@System.IO.Path.GetFileName(place.ImageUrl)" class="card-img-top" alt="@place.Title" style="height: 150px; object-fit: cover;">
                                        <div class="card-body">
                                            <h5 class="card-title">@place.Title</h5>
                                            <p class="card-text text-muted small">@(place.City?.Name ?? "Türkiye")</p>
                                            <a href="/Places/Details/@place.Id" class="btn btn-sm btn-outline-primary w-100">Detayları Gör</a>
                                        </div>
                                    </div>
                                </div>
                            }
                        }
                    </div>
                }
                else
                {
                    <div class="text-center py-5">
                        <i class="fa fa-heart-broken text-muted" style="font-size: 3rem;"></i>
                        <p class="text-muted mt-3">Henüz favori mekanınız bulunmuyor.</p>
                        <a href="/" class="btn btn-primary mt-2">Mekanları Keşfet</a>
                    </div>
                }
            </div>
        </div>
    </div>
</div>