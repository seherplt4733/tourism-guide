@model TourismGuide.Entity.Event
@{
    ViewData["Title"] = Model.Title;
    bool isAttending = ViewBag.IsAttending as bool? == true;
    var matchingPlace = ViewBag.MatchingPlace as TourismGuide.Entity.Place;
    var otherEvents = ViewBag.OtherEvents as List<TourismGuide.Entity.Event>;
    var imageSrc = string.IsNullOrEmpty(Model.ImageUrl) 
        ? "/img/destination-1.jpg" 
        : (Model.ImageUrl.StartsWith("http") ? Model.ImageUrl : "/img/" + System.IO.Path.GetFileName(Model.ImageUrl));
}

<div class="container-xxl py-5">
    <div class="container">
        <!-- Breadcrumb -->
        <nav aria-label="breadcrumb" class="mb-4">
            <ol class="breadcrumb mb-0 bg-light p-3 rounded">
                <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index" class="text-decoration-none text-primary"><i class="fa fa-home me-1"></i>Anasayfa</a></li>
                <li class="breadcrumb-item"><a href="/takvim" class="text-decoration-none text-primary">Etkinlik Takvimi</a></li>
                <li class="breadcrumb-item active" aria-current="page">@Model.Title</li>
            </ol>
        </nav>

        <!-- Üst Başlık & Banner -->
        <div class="position-relative rounded overflow-hidden shadow-sm mb-5" style="max-height: 440px; background-color: #212529;">
            <img class="img-fluid w-100" 
                 src="@imageSrc" 
                 alt="@Model.Title" 
                 style="height: 440px; object-fit: cover; opacity: 0.85;" 
                 onerror="this.src='/img/destination-1.jpg';">
            
            <div class="position-absolute bottom-0 start-0 w-100 p-4 p-md-5" style="background: linear-gradient(180deg, rgba(0,0,0,0) 0%, rgba(0,0,0,0.85) 100%);">
                <div class="d-flex flex-wrap gap-2 mb-3">
                    @if (!string.IsNullOrEmpty(Model.City?.Name))
                    {
                        <span class="badge bg-primary fs-6 px-3 py-2 rounded-pill shadow-sm">
                            <i class="fa fa-map-marker-alt me-1"></i>@Model.City.Name
                        </span>
                    }
                    @if (!Model.Price.HasValue || Model.Price.Value == 0)
                    {
                        <span class="badge bg-success fs-6 px-3 py-2 rounded-pill shadow-sm">
                            <i class="fa fa-ticket-alt me-1"></i>Ücretsiz Katılım
                        </span>
                    }
                    else
                    {
                        <span class="badge bg-warning text-dark fs-6 px-3 py-2 rounded-pill fw-bold shadow-sm">
                            <i class="fa fa-tag me-1"></i>₺@Model.Price.Value.ToString("N0")
                        </span>
                    }
                    <span class="badge bg-light text-dark fs-6 px-3 py-2 rounded-pill shadow-sm">
                        <i class="fa fa-calendar-alt text-primary me-1"></i>@Model.EventDate.ToString("dd MMMM yyyy", new System.Globalization.CultureInfo("tr-TR"))
                    </span>
                </div>
                <h1 class="text-white fw-bold mb-0 display-6">@Model.Title</h1>
            </div>
        </div>

        <div class="row g-5">
            <!-- Sol Kolon: Açıklama, Organizasyon Notları ve Diğer Etkinlikler -->
            <div class="col-lg-8">
                <!-- Açıklama Kartı -->
                <div class="bg-white rounded shadow-sm border p-4 p-md-5 mb-4">
                    <h4 class="fw-bold mb-4 pb-2 border-bottom text-dark">
                        <i class="fa fa-info-circle text-primary me-2"></i>Etkinlik Detayları ve Program
                    </h4>
                    <p class="text-secondary" style="line-height: 1.9; font-size: 1.05rem; white-space: pre-line;">
                        @Model.Description
                    </p>

                    <!-- Organizasyon & Katılım Notları -->
                    <div class="mt-5 p-4 rounded bg-light border-start border-4 border-primary">
                        <h5 class="fw-bold mb-3 text-dark">
                            <i class="fa fa-clipboard-check text-primary me-2"></i>Organizasyon ve Katılım Notları
                        </h5>
                        <ul class="list-unstyled mb-0 text-muted" style="line-height: 2;">
                            <li><i class="fa fa-check-circle text-primary me-2"></i>Etkinlik saatinden en az 15-20 dakika önce etkinlik alanında hazır bulunmanız tavsiye edilir.</li>
                            <li><i class="fa fa-check-circle text-primary me-2"></i>Girişlerde kimlik ve gerekliyse bilet kontrolü gerçekleştirilebilir.</li>
                            <li><i class="fa fa-check-circle text-primary me-2"></i>Hava durumu ve organizasyonel nedenlerle yapılabilecek güncellemeleri sitemizden takip edebilirsiniz.</li>
                            <li><i class="fa fa-check-circle text-primary me-2"></i>Mekan ve çevre temizliği kurallarına hassasiyet göstermenizi rica ederiz.</li>
                        </ul>
                    </div>
                </div>

                <!-- Diğer Yaklaşan Etkinlikler -->
                @if (otherEvents != null && otherEvents.Count > 0)
                {
                    <div class="bg-white rounded shadow-sm border p-4 mb-4">
                        <h5 class="fw-bold mb-4 text-dark">
                            <i class="fa fa-calendar-day text-primary me-2"></i>İlginizi Çekebilecek Diğer Etkinlikler
                        </h5>
                        <div class="row g-3">
                            @foreach (var other in otherEvents)
                            {
                                var otherImg = string.IsNullOrEmpty(other.ImageUrl) 
                                    ? "/img/destination-1.jpg" 
                                    : (other.ImageUrl.StartsWith("http") ? other.ImageUrl : "/img/" + System.IO.Path.GetFileName(other.ImageUrl));
                                <div class="col-md-4">
                                    <a href="/etkinlik-detay/@other.Id" class="text-decoration-none text-dark d-block h-100">
                                        <div class="card h-100 border hover-shadow transition" style="transition: transform .2s ease;">
                                            <img src="@otherImg" class="card-img-top" alt="@other.Title" style="height: 130px; object-fit: cover;" onerror="this.src='/img/destination-1.jpg';">
                                            <div class="card-body p-3 d-flex flex-column">
                                                <small class="text-primary fw-bold mb-1">
                                                    <i class="fa fa-calendar-alt me-1"></i>@other.EventDate.ToString("dd MMM yyyy", new System.Globalization.CultureInfo("tr-TR"))
                                                </small>
                                                <h6 class="fw-bold card-title mb-2 text-truncate" title="@other.Title">@other.Title</h6>
                                                <small class="text-muted mt-auto"><i class="fa fa-map-marker-alt me-1"></i>@(other.City?.Name ?? other.Location)</small>
                                            </div>
                                        </div>
                                    </a>
                                </div>
                            }
                        </div>
                    </div>
                }
            </div>

            <!-- Sağ Kolon: Sticky Bilgi Kartı -->
            <div class="col-lg-4">
                <div class="bg-white rounded shadow-sm border p-4 sticky-top" style="top: 100px; z-index: 10;">
                    <h5 class="fw-bold mb-4 pb-2 border-bottom text-dark">
                        <i class="fa fa-calendar-check text-primary me-2"></i>Etkinlik Bilgileri
                    </h5>

                    <!-- Tarih -->
                    <div class="mb-3 d-flex align-items-start gap-3">
                        <div class="rounded-circle bg-light text-primary d-flex align-items-center justify-content-center flex-shrink-0" style="width: 44px; height: 44px;">
                            <i class="fa fa-calendar-alt fs-5"></i>
                        </div>
                        <div>
                            <small class="text-muted d-block">Tarih</small>
                            <span class="fw-bold text-dark">@Model.EventDate.ToString("dd MMMM yyyy, dddd", new System.Globalization.CultureInfo("tr-TR"))</span>
                        </div>
                    </div>

                    <!-- Saat -->
                    <div class="mb-3 d-flex align-items-start gap-3">
                        <div class="rounded-circle bg-light text-primary d-flex align-items-center justify-content-center flex-shrink-0" style="width: 44px; height: 44px;">
                            <i class="fa fa-clock fs-5"></i>
                        </div>
                        <div>
                            <small class="text-muted d-block">Saat</small>
                            <span class="fw-bold text-dark">@Model.EventDate.ToString("HH:mm")</span>
                        </div>
                    </div>

                    <!-- Konum & Şehir -->
                    <div class="mb-3 d-flex align-items-start gap-3">
                        <div class="rounded-circle bg-light text-primary d-flex align-items-center justify-content-center flex-shrink-0" style="width: 44px; height: 44px;">
                            <i class="fa fa-map-marker-alt fs-5"></i>
                        </div>
                        <div>
                            <small class="text-muted d-block">Konum / Şehir</small>
                            <span class="fw-bold text-dark d-block">@Model.Location</span>
                            @if (!string.IsNullOrEmpty(Model.City?.Name))
                            {
                                <small class="text-muted">(@Model.City.Name)</small>
                            }
                        </div>
                    </div>

                    <!-- Ücret -->
                    <div class="mb-4 d-flex align-items-start gap-3">
                        <div class="rounded-circle bg-light text-primary d-flex align-items-center justify-content-center flex-shrink-0" style="width: 44px; height: 44px;">
                            <i class="fa fa-ticket-alt fs-5"></i>
                        </div>
                        <div>
                            <small class="text-muted d-block">Katılım Ücreti</small>
                            @if (!Model.Price.HasValue || Model.Price.Value == 0)
                            {
                                <span class="badge bg-success fs-5 px-3 py-1">Ücretsiz</span>
                            }
                            else
                            {
                                <span class="fw-bold text-primary fs-4">₺@Model.Price.Value.ToString("N0")</span>
                            }
                        </div>
                    </div>

                    <hr />

                    <!-- Buton Grubu -->
                    <div class="d-flex flex-column gap-2">
                        <!-- Katılıyorum Butonu (AJAX) -->
                        <button type="button" 
                                class="btn w-100 py-3 fw-bold @(isAttending ? "btn-success text-white shadow-sm" : "btn-primary shadow-sm")" 
                                id="btnAttendEvent" 
                                onclick="toggleAttendance(this, @Model.Id)">
                            <i class="fa @(isAttending ? "fa-check" : "fa-calendar-check") me-2"></i>
                            <span>@(isAttending ? "Katılıyorsunuz" : "Katılıyorum")</span>
                        </button>

                        <!-- Eşleşen Mekan Varsa Mekan Bilgilerini Gör Butonu -->
                        @if (matchingPlace != null)
                        {
                            <a href="/mekan-detay/@matchingPlace.Id" class="btn btn-outline-primary w-100 py-2 fw-semibold">
                                <i class="fa fa-landmark me-2"></i>Mekan Bilgilerini Gör (@matchingPlace.Title)
                            </a>
                        }

                        <!-- Google Haritalar'da Aç Butonu -->
                        @{
                            var mapQuery = Uri.EscapeDataString($"{Model.Location} {(Model.City != null ? Model.City.Name : "")}");
                            var mapUrl = $"https://www.google.com/maps/search/?api=1&query={mapQuery}";
                        }
                        <a href="@mapUrl" target="_blank" rel="noopener noreferrer" class="btn btn-outline-secondary w-100 py-2 fw-semibold">
                            <i class="fa fa-map-marked-alt text-danger me-2"></i>Google Haritalar'da Aç
                        </a>

                        <!-- Paylaş Butonu (Link Kopyala) -->
                        <button type="button" class="btn btn-light border w-100 py-2 fw-semibold" onclick="copyEventLink()">
                            <i class="fa fa-share-alt text-primary me-2"></i><span id="shareBtnText">Etkinliği Paylaş</span>
                        </button>

                        <a href="/takvim" class="btn btn-link text-decoration-none text-muted text-center py-2 mt-2">
                            <i class="fa fa-arrow-left me-1"></i>Etkinlik Takvimine Dön
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<script>
    function toggleAttendance(btnElement, eventId) {
        @if (User.Identity != null && !User.Identity.IsAuthenticated)
        {
            <text>
            if (typeof Swal !== 'undefined') {
                Swal.fire({
                    title: 'Giriş Yapmalısınız',
                    text: 'Etkinliğe katılmak için lütfen üye girişi yapın.',
                    icon: 'info',
                    showCancelButton: true,
                    confirmButtonColor: '#7bb017',
                    cancelButtonColor: '#6c757d',
                    confirmButtonText: 'Giriş Yap',
                    cancelButtonText: 'Vazgeç'
                }).then((result) => {
                    if (result.isConfirmed) {
                        window.location.href = '/Account/Login';
                    }
                });
            } else {
                alert('Etkinliğe katılmak için lütfen giriş yapın.');
                window.location.href = '/Account/Login';
            }
            return;
            </text>
        }

        fetch('/Account/ToggleAttendance', {
            method: 'POST',
            headers: {
                'Content-Type': 'application/x-www-form-urlencoded',
            },
            body: 'eventId=' + eventId
        })
        .then(response => response.json())
        .then(data => {
            if (data.success) {
                const icon = btnElement.querySelector('i');
                const span = btnElement.querySelector('span');
                if (data.isAttending) {
                    btnElement.classList.remove('btn-primary');
                    btnElement.classList.add('btn-success', 'text-white');
                    if (icon) icon.className = 'fa fa-check me-2';
                    if (span) span.innerText = 'Katılıyorsunuz';
                    if (typeof Swal !== 'undefined') {
                        Swal.fire({
                            toast: true,
                            position: 'top-end',
                            icon: 'success',
                            title: 'Etkinliğe katılımınız kaydedildi!',
                            showConfirmButton: false,
                            timer: 2500
                        });
                    }
                } else {
                    btnElement.classList.remove('btn-success', 'text-white');
                    btnElement.classList.add('btn-primary');
                    if (icon) icon.className = 'fa fa-calendar-check me-2';
                    if (span) span.innerText = 'Katılıyorum';
                    if (typeof Swal !== 'undefined') {
                        Swal.fire({
                            toast: true,
                            position: 'top-end',
                            icon: 'info',
                            title: 'Etkinlik katılımınız iptal edildi.',
                            showConfirmButton: false,
                            timer: 2500
                        });
                    }
                }
            } else if (data.requireLogin) {
                window.location.href = '/Account/Login';
            }
        })
        .catch(error => console.error('Hata:', error));
    }

    function copyEventLink() {
        const url = window.location.href;
        navigator.clipboard.writeText(url).then(function() {
            const btnText = document.getElementById('shareBtnText');
            if (btnText) {
                const originalText = btnText.innerText;
                btnText.innerText = 'Bağlantı Kopyalandı!';
                setTimeout(() => { btnText.innerText = originalText; }, 2500);
            }
            if (typeof Swal !== 'undefined') {
                Swal.fire({
                    toast: true,
                    position: 'top-end',
                    icon: 'success',
                    title: 'Etkinlik bağlantısı panoya kopyalandı!',
                    showConfirmButton: false,
                    timer: 2000
                });
            } else {
                alert('Etkinlik bağlantısı panoya kopyalandı!');
            }
        }).catch(function() {
            alert('Bağlantı kopyalanamadı.');
        });
    }
</script>
