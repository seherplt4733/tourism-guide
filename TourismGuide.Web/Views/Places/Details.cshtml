@model TourismGuide.Entity.Place

<div class="container my-5">
    <!-- Bilgilendirme Mesajı -->
    @if (TempData["ReviewMessage"] != null)
    {
        <div class="alert alert-info alert-dismissible fade show" role="alert">
            <i class="fa-solid fa-clock me-2"></i>@TempData["ReviewMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <!-- Mekan Detayları... -->

    <!-- YORUMLAR BÖLÜMÜ -->
    <div class="mt-5">
        <h3 class="mb-4"><i class="fa-solid fa-comments me-2"></i>Değerlendirmeler ve Yorumlar</h3>

        <!-- Onaylı Yorumlar Listesi -->
        @if (Model.Reviews != null && Model.Reviews.Any())
        {
            foreach (var review in Model.Reviews)
            {
                <div class="card mb-3 shadow-sm border-0">
                    <div class="card-body">
                        <div class="d-flex justify-content-between align-items-center mb-2">
                            <h6 class="fw-bold mb-0">@review.ReviewerName</h6>
                            <span class="text-warning">
                                @for (int i = 1; i <= 5; i++)
                                {
                                    <i class="fa-@(i <= review.Rating ? "solid" : "regular") fa-star"></i>
                                }
                            </span>
                        </div>
                        <p class="mb-1 text-secondary">@review.Comment</p>
                        <small class="text-muted">@review.CreatedAt.ToString("dd.MM.yyyy HH:mm")</small>
                    </div>
                </div>
            }
        }
        else
        {
            <p class="text-muted">Henüz yayınlanmış bir yorum bulunmuyor. İlk yorumu siz yapın!</p>
        }

        <!-- YORUM YAPMA FORMU -->
        <div class="card shadow-sm border-0 mt-4 p-4">
            <h5 class="fw-bold mb-3"><i class="fa-solid fa-pen me-2"></i>Yorum Yap</h5>
            <form asp-controller="Places" asp-action="AddReview" method="post">
                <input type="hidden" name="placeId" value="@Model.Id" />
                
                <div class="row g-3">
                    <div class="col-md-6">
                        <label class="form-label fw-bold">Adınız</label>
                        <input type="text" name="reviewerName" class="form-control" placeholder="Adınız Soyadınız" required />
                    </div>
                    <div class="col-md-6">
                        <label class="form-label fw-bold">Puanınız</label>
                        <select name="rating" class="form-select" required>
                            <option value="5">⭐⭐⭐⭐⭐ (5/5)</option>
                            <option value="4">⭐⭐⭐⭐ (4/5)</option>
                            <option value="3">⭐⭐⭐ (3/5)</option>
                            <option value="2">⭐⭐ (2/5)</option>
                            <option value="1">⭐ (1/5)</option>
                        </select>
                    </div>
                    <div class="col-12">
                        <label class="form-label fw-bold">Yorumunuz</label>
                        <textarea name="comment" class="form-control" rows="3" placeholder="Mekan hakkındaki deneyimleriniz..." required></textarea>
                    </div>
                    <div class="col-12 text-end">
                        <button type="submit" class="btn btn-primary px-4">Yorumu Gönder</button>
                    </div>
                </div>
            </form>
        </div>
    </div>
</div>