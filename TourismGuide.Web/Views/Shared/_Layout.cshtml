@{
    bool isEnglish = Context.Request.Query["lang"] == "en";
    string currentLang = isEnglish ? "en" : "tr";
}
<!DOCTYPE html>
<html lang="@currentLang">

<head>
    <meta charset="utf-8">
    <title>@ViewData["Title"] - Tourist</title>
    <meta content="width=device-width, initial-scale=1.0" name="viewport">
    <meta content="" name="keywords">
    <meta content="" name="description">

    <!-- Favicon -->
    <link href="/img/favicon.ico" rel="icon">

    <!-- Google Web Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Heebo:wght@400;500;600&family=Nunito:wght@600;700;800&display=swap" rel="stylesheet">

    <!-- Icon Font Stylesheet -->
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/5.10.0/css/all.min.css" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.4.1/font/bootstrap-icons.css" rel="stylesheet">

    <!-- Libraries Stylesheet -->
    <link href="/lib/animate/animate.min.css" rel="stylesheet">

    <!-- Customized Bootstrap Stylesheet -->
    <link href="/css/bootstrap.min.css" rel="stylesheet">

    <!-- Template Stylesheet -->
    <link href="/css/style.css" rel="stylesheet">

    <!-- Custom Site Stylesheet -->
    <link href="/css/site.css" rel="stylesheet">

    @await RenderSectionAsync("Styles", required: false)
</head>

<body>
    <!-- Spinner Start -->
    <div id="spinner" class="show bg-white position-fixed translate-middle w-100 vh-100 top-50 start-50 d-flex align-items-center justify-content-center">
        <div class="spinner-border text-primary" style="width: 3rem; height: 3rem;" role="status">
            <span class="sr-only">@(isEnglish ? "Loading..." : "Yükleniyor...")</span>
        </div>
    </div>
    <!-- Spinner End -->


    <!-- Topbar Start -->
    <div class="container-fluid bg-dark px-5 d-none d-lg-block">
        <div class="row gx-0">
            <div class="col-lg-8 text-center text-lg-start mb-2 mb-lg-0">
                <div class="d-inline-flex align-items-center" style="height: 45px;">
                    <small class="me-3 text-light"><i class="fa fa-map-marker-alt me-2"></i>@(isEnglish ? "123 Street, New York, USA" : "123 Sokak, New York, ABD")</small>
                    <small class="me-3 text-light"><i class="fa fa-phone-alt me-2"></i>+012 345 6789</small>
                    <small class="text-light"><i class="fa fa-envelope-open me-2"></i>info@example.com</small>
                </div>
            </div>
            <div class="col-lg-4 text-center text-lg-end">
                <div class="d-inline-flex align-items-center" style="height: 45px;">
                    <a class="btn btn-sm btn-outline-light btn-sm-square rounded-circle me-2" href=""><i class="fab fa-twitter fw-normal"></i></a>
                    <a class="btn btn-sm btn-outline-light btn-sm-square rounded-circle me-2" href=""><i class="fab fa-facebook-f fw-normal"></i></a>
                    <a class="btn btn-sm btn-outline-light btn-sm-square rounded-circle me-2" href=""><i class="fab fa-linkedin-in fw-normal"></i></a>
                    <a class="btn btn-sm btn-outline-light btn-sm-square rounded-circle me-2" href=""><i class="fab fa-instagram fw-normal"></i></a>
                    <a class="btn btn-sm btn-outline-light btn-sm-square rounded-circle me-2" href=""><i class="fab fa-youtube fw-normal"></i></a>
                    
                    <!-- Admin Girişi Butonu -->
                    <a asp-area="Admin" asp-controller="Account" asp-action="Login" class="btn btn-sm btn-outline-warning ms-2">
                        <i class="fa fa-user-lock me-1"></i> @(isEnglish ? "Admin Login" : "Admin Girişi")
                    </a>
                </div>
            </div>
        </div>
    </div>
    <!-- Topbar End -->


    <!-- Navbar & Hero Start -->
    <div class="container-fluid position-relative p-0">
        <nav class="navbar navbar-expand-lg navbar-light px-4 px-lg-5 py-3 py-lg-0">
            <a asp-controller="Home" asp-action="Index" asp-route-lang="@currentLang" class="navbar-brand p-0">
                <h1 class="text-primary m-0"><i class="fa fa-map-marker-alt me-3"></i>Tourist</h1>
            </a>
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarCollapse">
                <span class="fa fa-bars"></span>
            </button>
            <div class="collapse navbar-collapse" id="navbarCollapse">
                <div class="navbar-nav ms-auto py-0">
                    <a asp-controller="Home" asp-action="Index" asp-route-lang="@currentLang" class="nav-item nav-link active">
                        @(isEnglish ? "Home" : "Ana Sayfa")
                    </a>
                    <a href="/?lang=@currentLang#about" class="nav-item nav-link">
                        @(isEnglish ? "About" : "Hakkımızda")
                    </a>
                    <a href="/?lang=@currentLang#service" class="nav-item nav-link">
                        @(isEnglish ? "Services" : "Hizmetler")
                    </a>
                    <a href="/?lang=@currentLang#destination" class="nav-item nav-link">
                        @(isEnglish ? "Destination" : "Popüler Mekanlar")
                    </a>
                    <a href="/?lang=@currentLang#contact" class="nav-item nav-link">
                        @(isEnglish ? "Contact" : "İletişim")
                    </a>
                </div>
                
                <!-- Dil Switcher -->
                <div class="d-flex align-items-center ms-3">
                    @if (isEnglish)
                    {
                        <a href="?lang=tr" class="text-secondary me-1 small text-decoration-none fw-bold">TR</a>
                        <span class="text-muted small">|</span>
                        <span class="badge bg-primary ms-1 px-2 py-1">EN</span>
                    }
                    else
                    {
                        <span class="badge bg-primary me-1 px-2 py-1">TR</span>
                        <span class="text-muted small">|</span>
                        <a href="?lang=en" class="text-secondary ms-1 small text-decoration-none fw-bold">EN</a>
                    }
                </div>
            </div>
        </nav>

        @if (ViewData["IsHome"] as bool? == true)
        {
            <div class="container-fluid bg-primary py-5 mb-5 hero-header">
                <div class="container py-5">
                    <div class="row justify-content-center py-5">
                        <div class="col-lg-10 pt-lg-5 mt-lg-5 text-center">
                            <h1 class="display-3 text-white mb-3 animated slideInDown">
                                @(isEnglish ? "Enjoy Your Vacation With Us" : "Tatilinizin Tadını Bizimle Çıkarın")
                            </h1>
                            <p class="fs-4 text-white mb-4 animated slideInDown">
                                @(isEnglish ? "Discover top tourist destinations in Turkey and around the world" : "Türkiye ve dünyadaki en güzel turistik mekanları keşfedin")
                            </p>
                            <div class="position-relative w-75 mx-auto animated slideInDown">
                                <form asp-controller="Home" asp-action="Index" method="get">
                                    <input type="hidden" name="lang" value="@currentLang" />
                                    <input class="form-control border-0 rounded-pill w-100 py-3 ps-4 pe-5" type="text" name="searchKeyword" value="@ViewBag.SearchKeyword" placeholder="@(isEnglish ? "Eg: Thailand, Istanbul" : "Örn: Pamukkale, İstanbul")">
                                    <button type="submit" class="btn btn-primary rounded-pill py-2 px-4 position-absolute top-0 end-0 me-2" style="margin-top: 7px;">
                                        @(isEnglish ? "Search" : "Ara")
                                    </button>
                                </form>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
    <!-- Navbar & Hero End -->

    <!-- Main Content -->
    @RenderBody()

    <!-- Footer Start -->
    <div class="container-fluid bg-dark text-light footer pt-5 mt-5 wow fadeIn" data-wow-delay="0.1s">
        <div class="container py-5">
            <div class="row g-5">
                <div class="col-lg-3 col-md-6">
                    <h4 class="text-white mb-3">@(isEnglish ? "Company" : "Kurumsal")</h4>
                    <a class="btn btn-link" href="/?lang=@currentLang#about">@(isEnglish ? "About Us" : "Hakkımızda")</a>
                    <a class="btn btn-link" href="/?lang=@currentLang#contact">@(isEnglish ? "Contact Us" : "İletişim")</a>
                    <a class="btn btn-link" href="">@(isEnglish ? "Privacy Policy" : "Gizlilik Politikası")</a>
                    <a class="btn btn-link" href="">@(isEnglish ? "Terms & Condition" : "Kullanım Şartları")</a>
                    <a class="btn btn-link" href="">@(isEnglish ? "FAQs & Help" : "SSS & Yardım")</a>
                </div>
                <div class="col-lg-3 col-md-6">
                    <h4 class="text-white mb-3">@(isEnglish ? "Contact" : "İletişim")</h4>
                    <p class="mb-2"><i class="fa fa-map-marker-alt me-3"></i>@(isEnglish ? "123 Street, New York, USA" : "123 Sokak, New York, ABD")</p>
                    <p class="mb-2"><i class="fa fa-phone-alt me-3"></i>+012 345 67890</p>
                    <p class="mb-2"><i class="fa fa-envelope me-3"></i>info@example.com</p>
                    <div class="d-flex pt-2">
                        <a class="btn btn-outline-light btn-social" href=""><i class="fab fa-twitter"></i></a>
                        <a class="btn btn-outline-light btn-social" href=""><i class="fab fa-facebook-f"></i></a>
                        <a class="btn btn-outline-light btn-social" href=""><i class="fab fa-youtube"></i></a>
                        <a class="btn btn-outline-light btn-social" href=""><i class="fab fa-linkedin-in"></i></a>
                    </div>
                </div>
                <div class="col-lg-3 col-md-6">
                    <h4 class="text-white mb-3">@(isEnglish ? "Gallery" : "Galeri")</h4>
                    <div class="row g-2 pt-2">
                        <div class="col-4"><img class="img-fluid bg-light p-1" src="/img/destination-1.jpg" alt=""></div>
                        <div class="col-4"><img class="img-fluid bg-light p-1" src="/img/destination-2.jpg" alt=""></div>
                        <div class="col-4"><img class="img-fluid bg-light p-1" src="/img/destination-3.jpg" alt=""></div>
                        <div class="col-4"><img class="img-fluid bg-light p-1" src="/img/destination-2.jpg" alt=""></div>
                        <div class="col-4"><img class="img-fluid bg-light p-1" src="/img/destination-3.jpg" alt=""></div>
                        <div class="col-4"><img class="img-fluid bg-light p-1" src="/img/destination-1.jpg" alt=""></div>
                    </div>
                </div>
                <div class="col-lg-3 col-md-6">
                    <h4 class="text-white mb-3">@(isEnglish ? "Newsletter" : "E-Bülten")</h4>
                    <p>@(isEnglish ? "Subscribe to get the latest travel updates and offers." : "En yeni gezilecek yerler ve fırsatlardan haberdar olmak için abone olun.")</p>
                    <div class="position-relative mx-auto" style="max-width: 400px;">
                        <input class="form-control border-primary w-100 py-3 ps-4 pe-5" type="text" placeholder="@(isEnglish ? "Your Email" : "E-posta adresiniz")">
                        <button type="button" class="btn btn-primary py-2 position-absolute top-0 end-0 mt-2 me-2">
                            @(isEnglish ? "Subscribe" : "Abone Ol")
                        </button>
                    </div>
                </div>
            </div>
        </div>
        <div class="container">
            <div class="copyright">
                <div class="row">
                    <div class="col-md-6 text-center text-md-start mb-3 mb-md-0">
                        &copy; <a class="border-bottom" href="#">Tourist</a>, @(isEnglish ? "All Rights Reserved." : "Tüm Hakları Saklıdır.") Designed By <a class="border-bottom" href="https://htmlcodex.com">HTML Codex</a>
                    </div>
                    <div class="col-md-6 text-center text-md-end">
                        <div class="footer-menu">
                            <a href="/?lang=@currentLang">@(isEnglish ? "Home" : "Ana Sayfa")</a>
                            <a href="">@(isEnglish ? "Cookies" : "Çerezler")</a>
                            <a href="">@(isEnglish ? "Help" : "Yardım")</a>
                            <a href="">@(isEnglish ? "FAQs" : "SSS")</a>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <!-- Footer End -->

    <!-- Back to Top -->
    <a href="#" class="btn btn-lg btn-primary btn-lg-square back-to-top"><i class="bi bi-arrow-up"></i></a>

    <!-- JavaScript Libraries -->
    <script src="https://code.jquery.com/jquery-3.4.1.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.0.0/dist/js/bootstrap.bundle.min.js"></script>
    <script src="/lib/wow/wow.min.js"></script>
    <script src="/lib/easing/easing.min.js"></script>
    <script src="/lib/waypoints/waypoints.min.js"></script>

    <!-- Template Javascript -->
    <script src="/js/main.js"></script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>