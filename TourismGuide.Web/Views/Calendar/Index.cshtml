@model IEnumerable<TourismGuide.Entity.Event>
@{
    ViewData["Title"] = "Etkinlik Takvimi";
    var cities = ViewBag.Cities as List<TourismGuide.Entity.City> ?? new List<TourismGuide.Entity.City>();
}

<!-- FullCalendar v6 CDN -->
<script src="https://cdn.jsdelivr.net/npm/fullcalendar@6.1.10/index.global.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/@@fullcalendar/core@6.1.10/locales/tr.global.min.js"></script>

<style>
    .calendar-card {
        background: #ffffff;
        border-radius: 1.25rem;
        box-shadow: 0 10px 30px rgba(0, 0, 0, 0.05);
        border: 1px solid #edf0f5;
        padding: 2rem;
    }
    .filter-card {
        background: #ffffff;
        border-radius: 1rem;
        box-shadow: 0 4px 20px rgba(0, 0, 0, 0.04);
        border: 1px solid #edf0f5;
        padding: 1.25rem 1.5rem;
        margin-bottom: 2rem;
    }
    .fc-header-toolbar {
        margin-bottom: 1.75rem !important;
        flex-wrap: wrap;
        gap: 0.75rem;
    }
    .fc .fc-toolbar-title {
        font-size: 1.5rem;
        font-weight: 700;
        color: #14141F;
    }
    .fc .fc-button-primary {
        background-color: #86B817 !important;
        border-color: #86B817 !important;
        font-weight: 600;
        border-radius: 0.5rem !important;
        padding: 0.45rem 1.1rem !important;
        box-shadow: none !important;
        transition: all 0.2s ease;
    }
    .fc .fc-button-primary:hover {
        background-color: #729d13 !important;
        border-color: #729d13 !important;
    }
    .fc .fc-button-primary:disabled {
        background-color: #c5dda0 !important;
        border-color: #c5dda0 !important;
        cursor: not-allowed;
    }
    .fc .fc-button-primary.fc-button-active {
        background-color: #5d820d !important;
        border-color: #5d820d !important;
    }
    .fc-theme-standard th {
        background-color: #f8fafc;
        padding: 0.85rem 0;
        font-weight: 600;
        color: #475569;
        border-color: #eef2f6 !important;
    }
    .fc-theme-standard td {
        border-color: #eef2f6 !important;
    }
    .fc-event {
        cursor: pointer;
        border-radius: 6px;
        padding: 4px 8px;
        font-size: 0.85rem;
        font-weight: 500;
        background-color: #86B817 !important;
        border-color: #729d13 !important;
        color: #ffffff !important;
        transition: transform 0.15s ease, box-shadow 0.15s ease;
    }
    .fc-event:hover {
        transform: translateY(-2px);
        box-shadow: 0 4px 12px rgba(134, 184, 23, 0.4);
    }
    .fc-event-title {
        font-weight: 600;
    }
    .fc-day-today {
        background-color: rgba(134, 184, 23, 0.08) !important;
    }
    .btn-view-switch {
        border-radius: 0.5rem;
        font-weight: 500;
        padding: 0.4rem 0.9rem;
    }
</style>

<div class="container-xxl py-5">
    <div class="container">
        <!-- Başlık Bölümü -->
        <div class="text-center wow fadeInUp mb-5" data-wow-delay="0.1s">
            <h6 class="section-title bg-white text-center text-primary px-3">Etkinlikler</h6>
            <h1 class="mb-2">Etkinlik Takvimi</h1>
            <p class="text-muted">Şehirdeki konser, festival, tiyatro ve tüm etkinlikleri interaktif takvimden keşfedin.</p>
        </div>

        <!-- Hızlı Filtreleme Alanı -->
        <div class="filter-card wow fadeInUp" data-wow-delay="0.2s">
            <div class="row g-3 align-items-center">
                <div class="col-md-4">
                    <label class="form-label small text-muted fw-bold mb-1">
                        <i class="fa fa-city text-primary me-1"></i> Şehir Filtresi
                    </label>
                    <select id="cityFilter" class="form-select rounded-3">
                        <option value="">Tüm Şehirler</option>
                        @if (cities != null)
                        {
                            foreach (var city in cities)
                            {
                                <option value="@city.Id">@(city?.Name ?? "İsimsiz Şehir")</option>
                            }
                        }
                    </select>
                </div>
                <div class="col-md-5">
                    <label class="form-label small text-muted fw-bold mb-1">
                        <i class="fa fa-search text-primary me-1"></i> Etkinlik veya Mekan Ara
                    </label>
                    <input type="text" id="searchInput" class="form-control rounded-3" placeholder="Örn: Konser, Atatürk Kültür Merkezi...">
                </div>
                <div class="col-md-3 d-flex align-items-end gap-2 pt-3 pt-md-0">
                    <button type="button" id="btnFilter" class="btn btn-primary text-white rounded-3 flex-grow-1">
                        <i class="fa fa-filter me-1"></i> Filtrele
                    </button>
                    <button type="button" id="btnReset" class="btn btn-outline-secondary rounded-3" title="Filtreleri Temizle">
                        <i class="fa fa-undo"></i>
                    </button>
                </div>
            </div>
        </div>

        <!-- Takvim Kartı -->
        <div class="calendar-card wow fadeInUp" data-wow-delay="0.3s">
            <div id="calendar"></div>
        </div>
    </div>
</div>

<!-- Etkinlik Detay Modalı -->
<div class="modal fade" id="eventDetailModal" tabindex="-1" aria-labelledby="eventDetailModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow-lg" style="border-radius: 1rem; overflow: hidden;">
            <div class="modal-header text-white" style="background-color: #86B817;">
                <h5 class="modal-title text-white fw-bold" id="eventDetailModalLabel">
                    <i class="fa fa-calendar-check me-2"></i>Etkinlik Detayı
                </h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Kapat"></button>
            </div>
            <div class="modal-body p-4">
                <div class="text-center mb-3">
                    <img id="modalEventImage" src="/img/destination-1.jpg" alt="Etkinlik Görseli" class="img-fluid rounded-3 shadow-sm w-100" style="max-height: 220px; object-fit: cover;" onerror="this.src='/img/destination-1.jpg';">
                </div>
                <h4 id="modalEventTitle" class="fw-bold mb-3 text-dark"></h4>
                <div class="d-flex flex-column gap-2 mb-3 bg-light p-3 rounded-3">
                    <div class="d-flex align-items-center">
                        <i class="fa fa-calendar-alt text-primary me-2" style="width: 22px;"></i>
                        <span class="text-muted me-2">Tarih & Saat:</span>
                        <span id="modalEventDate" class="fw-bold text-dark"></span>
                    </div>
                    <div class="d-flex align-items-center">
                        <i class="fa fa-map-marker-alt text-primary me-2" style="width: 22px;"></i>
                        <span class="text-muted me-2">Mekan:</span>
                        <span id="modalEventLocation" class="fw-bold text-dark"></span>
                    </div>
                    <div class="d-flex align-items-center">
                        <i class="fa fa-city text-primary me-2" style="width: 22px;"></i>
                        <span class="text-muted me-2">Şehir:</span>
                        <span id="modalEventCity" class="fw-bold text-dark"></span>
                    </div>
                    <div class="d-flex align-items-center">
                        <i class="fa fa-ticket-alt text-primary me-2" style="width: 22px;"></i>
                        <span class="text-muted me-2">Ücret:</span>
                        <span id="modalEventPrice" class="badge bg-success fs-6 fw-bold"></span>
                    </div>
                </div>
                <div id="modalDescWrapper" class="mt-2">
                    <h6 class="fw-bold text-dark mb-1"><i class="fa fa-info-circle text-primary me-1"></i> Açıklama:</h6>
                    <p id="modalEventDesc" class="text-muted small mb-0" style="line-height: 1.6; max-height: 120px; overflow-y: auto;"></p>
                </div>
            </div>
            <div class="modal-footer bg-light border-0">
                <button type="button" class="btn btn-secondary rounded-pill px-4" data-bs-dismiss="modal">Kapat</button>
                <a id="modalDetailBtn" href="#" class="btn btn-primary rounded-pill px-4 text-white fw-bold">
                    <i class="fa fa-external-link-alt me-1"></i>Detaylara Git
                </a>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            var calendarEl = document.getElementById('calendar');
            var cityFilter = document.getElementById('cityFilter');
            var searchInput = document.getElementById('searchInput');
            var btnFilter = document.getElementById('btnFilter');
            var btnReset = document.getElementById('btnReset');

            var modalElement = document.getElementById('eventDetailModal');
            var eventModal = new bootstrap.Modal(modalElement);

            var calendar = new FullCalendar.Calendar(calendarEl, {
                locale: 'tr',
                initialView: 'dayGridMonth',
                headerToolbar: {
                    left: 'prev,next today',
                    center: 'title',
                    right: 'dayGridMonth,timeGridWeek,timeGridDay,listMonth'
                },
                buttonText: {
                    today: 'Bugün',
                    month: 'Ay',
                    week: 'Hafta',
                    day: 'Gün',
                    list: 'Liste'
                },
                events: function (fetchInfo, successCallback, failureCallback) {
                    var params = new URLSearchParams();
                    if (cityFilter.value) params.append('cityId', cityFilter.value);
                    if (searchInput.value.trim()) params.append('search', searchInput.value.trim());

                    fetch('/api/etkinlikler-json?' + params.toString())
                        .then(function (response) { return response.json(); })
                        .then(function (data) {
                            successCallback(data);
                        })
                        .catch(function (error) {
                            console.error('Etkinlikler yüklenirken hata:', error);
                            failureCallback(error);
                        });
                },
                eventTimeFormat: {
                    hour: '2-digit',
                    minute: '2-digit',
                    meridiem: false,
                    hour12: false
                },
                eventClick: function (info) {
                    info.jsEvent.preventDefault();
                    
                    var props = info.event.extendedProps || {};
                    var eventDate = info.event.start;
                    var dateStr = eventDate ? eventDate.toLocaleDateString('tr-TR', { 
                        year: 'numeric', 
                        month: 'long', 
                        day: 'numeric', 
                        hour: '2-digit', 
                        minute: '2-digit' 
                    }) : '';

                    document.getElementById('modalEventTitle').textContent = info.event.title || 'Etkinlik';
                    document.getElementById('modalEventDate').textContent = dateStr;
                    document.getElementById('modalEventLocation').textContent = props.location || 'Konum belirtilmedi';
                    document.getElementById('modalEventCity').textContent = props.cityName || 'Şehir belirtilmedi';
                    document.getElementById('modalEventPrice').textContent = props.price || 'Ücretsiz';
                    
                    var descEl = document.getElementById('modalEventDesc');
                    var descWrap = document.getElementById('modalDescWrapper');
                    if (props.description) {
                        descEl.textContent = props.description;
                        descWrap.style.display = 'block';
                    } else {
                        descWrap.style.display = 'none';
                    }

                    var imgEl = document.getElementById('modalEventImage');
                    imgEl.src = props.imageUrl || '/img/destination-1.jpg';

                    var detailBtn = document.getElementById('modalDetailBtn');
                    var detailUrl = info.event.url || ('/etkinlik-detay/' + info.event.id);
                    detailBtn.setAttribute('href', detailUrl);

                    eventModal.show();
                }
            });

            calendar.render();

            // Filtreleme butonuna tıklanınca
            btnFilter.addEventListener('click', function () {
                calendar.refetchEvents();
            });

            // Enter tuşuna basınca arama tetiklensin
            searchInput.addEventListener('keypress', function (e) {
                if (e.key === 'Enter') {
                    calendar.refetchEvents();
                }
            });

            // Şehir filtresi değişince otomatik yenile
            cityFilter.addEventListener('change', function () {
                calendar.refetchEvents();
            });

            // Filtreleri sıfırla
            btnReset.addEventListener('click', function () {
                cityFilter.value = '';
                searchInput.value = '';
                calendar.refetchEvents();
            });
        });
    </script>
}
